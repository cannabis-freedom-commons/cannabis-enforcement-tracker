---
// All reports as a list: search and filter by type, tag, country, period and figures, newest first.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import ReportBrowser from "../../components/ReportBrowser.astro";
import { reports, countriesWithReports, years } from "../../lib/reports.js";
const fmt = (n) => n.toLocaleString("en-GB");
const base = import.meta.env.BASE_URL;
---
<Base title="Reports" description="Every report of cannabis eradication, seizures, raids, arrests, prosecutions and sentences, searchable and filterable." wide>
  <div class="reports-heading">
    <h1>Reports</h1>
    <a class="rss-button" href={`${base}feed.xml`} type="application/rss+xml" aria-label="Subscribe to reports via RSS">
      <Icon name="rss-feed" />
      RSS
    </a>
  </div>
  <p class="lead">
    {fmt(reports.length)} reports from {countriesWithReports().length} countries and states, newest first. Search them, filter by
    type, tag, country, date and figures such as plants destroyed or people arrested, or <a href={`${base}${years[0] ?? ""}/`}>browse by month</a>.
  </p>
  <ReportBrowser />
</Base>


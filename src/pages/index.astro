---
// The map: all reports on a full-screen map with its filters floating over it (FilterBar), and the
// list of the reports they match in a pane on the right.
import Base from "../layouts/Base.astro";
import WorldMap from "../components/WorldMap.astro";
import FilterBar from "../components/FilterBar.astro";
import ReportBrowser from "../components/ReportBrowser.astro";
import RoutesPane from "../components/RoutesPane.astro";
import RoutesBar from "../components/RoutesBar.astro";
import Icon from "../components/Icon.astro";
import "../styles/routes.css";
import "../styles/report.css";
import { reports, countriesWithReports, totals } from "../lib/reports.js";

const t = totals(reports);
const fmt = (n) => n.toLocaleString("en-GB");
const base = import.meta.env.BASE_URL;
const site = new URL(base, Astro.site).href;
const description = `A sourced world record of cannabis enforcement: ${fmt(t.reports)} reports of eradication, seizures, raids, arrests, prosecutions, sentences and executions in ${countriesWithReports().length} countries and states, on a map.`;
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}#website`,
  name: "Cannabis Enforcement Tracker",
  url: site,
  description,
  inLanguage: "en",
  publisher: { "@id": `${site}#organization` },
}, {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site}#organization`,
  name: "Cannabis Enforcement Tracker",
  url: site,
  logo: new URL(`${base}og.png`, Astro.site).href,
  sameAs: ["https://github.com/cannabis-freedom-commons/cet"],
  parentOrganization: { "@type": "Organization", name: "Cannabis Freedom Index", url: "https://cannabisfreedom.fyi/" },
}, {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Cannabis Enforcement Tracker reports",
  description,
  url: site,
  license: "https://creativecommons.org/licenses/by/4.0/", // report texts and data (README.md, Licence)
  creator: { "@id": `${site}#organization` },
  isAccessibleForFree: true,
  distribution: [
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: new URL(`${base}api/reports.json`, Astro.site).href },
    { "@type": "DataDownload", encodingFormat: "application/rss+xml", contentUrl: new URL(`${base}feed.xml`, Astro.site).href },
  ],
}];
---
<Base app description={description} jsonLd={jsonLd}>
  <div class="home">
    <h1 class="sr-only">Cannabis Enforcement Tracker: the map of reports</h1>
    <div class="home-map">
      <WorldMap hash label="World map of enforcement reports" />
      {/* two views of the same map: the reports (the default) and the smuggling routes (?view=routes),
          chosen before the page is drawn so the other view never flashes; src/scripts/routes-view.js */}
      <script is:inline>{ const q = new URLSearchParams(location.search); if (q.get("view") === "routes") document.documentElement.dataset.homeView = "routes"; window.__openReport = q.get("open"); }</script>
      <FilterBar>
        <div class="view-switch" slot="start" role="group" aria-label="What the map shows">
          <button type="button" data-view="reports" aria-pressed="true" title="Reports on the map">
            <Icon name="map-pin" /><span>Reports</span>
          </button>
          <button type="button" data-view="routes" aria-pressed="false" title="Smuggling routes: where the cannabis came from and went">
            <Icon name="path-arrow" /><span>Routes</span>
          </button>
        </div>
        <RoutesBar part="fields" slot="routes" />
        <RoutesBar part="active" slot="routes-active" />
      </FilterBar>
      <RoutesBar part="timeline" />
    </div>
    <aside class="home-pane" aria-label="Reports and routes">
      <RoutesPane />
      {/* a report opened from the map or the list, read in place (src/scripts/report-pane.js) */}
      <section class="report-pane" id="report-pane" aria-label="Report" hidden>
        <div class="rpane-bar">
          <button type="button" class="rpane-back" data-close>← All reports</button>
          <a class="rpane-full" data-full href="#">Full page <Icon name="open-new-window" /></a>
        </div>
        <div class="rpane-body" data-body aria-live="polite"></div>
      </section>
      <ReportBrowser compact mapFilters />
      <footer class="pane-foot">
        <p>Fields burned, homes raided, people arrested, jailed and executed: a sourced record of what
          cannabis prohibition does to people. {fmt(t.reports)} reports, {countriesWithReports().length} countries and states.</p>
        A companion to the <a href="https://cannabisfreedom.fyi/" target="_blank" rel="noopener">Cannabis Freedom Index</a>.
        Every report cites its sources. Data: <a href={`${base}api/reports.json`}>JSON</a> · <a href={`${base}feed.xml`}>RSS</a> · <a href={`${base}changelog/`}>Changelog</a> · <a href={`${base}submissions/`}>Submit</a>.
      </footer>
    </aside>
  </div>
</Base>

<script>
  import "../scripts/routes-view.js";
  import "../scripts/report-pane.js";
</script>

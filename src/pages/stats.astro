</style>
<style is:global>
  /* column charts, shared with components/stats/BandChart.astro */
  .chart-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 760px) { .chart-pair { grid-template-columns: 1fr; } }
  .col-chart { margin: 0; padding: 16px 18px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; min-width: 0; }
  .col-chart figcaption { margin-bottom: 14px; font-size: 14px; }
  .col-chart figcaption span { color: var(--muted); font-size: 12.5px; }
  .cols { display: grid; grid-template-columns: repeat(var(--n), 1fr); align-items: end; gap: 2px; height: 160px; border-bottom: 1px solid var(--border); }
  .col { display: flex; align-items: flex-end; height: 100%; min-width: 0; }
  .col i { display: block; width: 100%; min-height: 0; background: var(--text-2); border-radius: 3px 3px 0 0; transition: background .15s; }
  .col:hover i, .col:focus-visible i { background: var(--text); }
  .col-axis { display: grid; grid-template-columns: repeat(var(--n), 1fr); margin-top: 6px; font: 10.5px var(--mono); color: var(--muted); }
  .col-axis span { white-space: nowrap; overflow: visible; }

  /* banded counts: the value over each column; bands kept apart from the scale are striped */
  .band-chart .cols { padding-top: 20px; }
  .band-chart .col { position: relative; }
  .band-chart .col i { height: var(--h); min-height: 2px; }
  .band-chart .col:hover i, .band-chart .col:focus-visible i { background: var(--text); }
  .band-chart .col:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
  .band-chart .col.apart i { background: repeating-linear-gradient(135deg, var(--text-2) 0 2px, transparent 2px 5px); box-shadow: inset 0 0 0 1px var(--text-2); }
  .col-val { position: absolute; left: 0; right: 0; bottom: calc(var(--h) + 4px); text-align: center; font: 11px var(--mono); color: var(--text-2); font-variant-numeric: tabular-nums; }
  .band-axis { gap: 2px; }
  .band-axis span { text-align: center; }
  .chart-note { margin: 10px 0 0; font-size: 12.5px; color: var(--muted); }
  .added-chart { margin-top: 20px; }
  .added-chart .cols { gap: 1px; height: 120px; }

</style>

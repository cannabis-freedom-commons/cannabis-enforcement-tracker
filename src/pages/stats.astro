  .fc-label { margin-top: 8px; font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--text-2); }
  .fc-note { margin-top: 4px; font: 11px var(--mono); color: var(--muted); font-variant-numeric: tabular-nums; }

  .mix-title { margin-top: 28px; }
  .season { min-width: 720px; }
  .season thead th:first-child { width: 9.5rem; }
  .season tbody th .dot { margin-right: 6px; }
  .tag-cloud { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 4px 14px; margin: 16px 0 0; padding: 22px 24px; list-style: none; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; }
  .tag-cloud a { color: var(--text-2); text-decoration: none; line-height: 1.25; white-space: nowrap; }
  .tag-cloud a:hover, .tag-cloud a:focus-visible { color: var(--text); text-decoration: underline; }
  .tc-1 { font-size: 12px; color: var(--muted) !important; }
  .tc-2 { font-size: 14px; }
  .tc-3 { font-size: 16.5px; }
  .tc-4 { font-size: 20px; font-weight: 500; }
  .tc-5 { font-size: 25px; font-weight: 500; color: var(--text) !important; }
  .tc-6 { font-size: 31px; font-weight: 600; color: var(--text) !important; letter-spacing: -.01em; }
  .sources-grid { margin-bottom: 8px; }
  .small { font-size: 12.5px; margin: -4px 0 8px; }
  .sub-title { margin-top: 26px; }
  .tld-group { margin: 14px 0 2px; font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .tld-flag { display: inline-block; width: 1.5em; }
  .hb-label code { font-size: 12.5px; }
  .sources-grid .hbars li { cursor: default; }
  .kind-0, .prec-0 { background: var(--text); }
  .kind-1, .prec-1 { background: var(--text-2); }
  .kind-2, .prec-2 { background: repeating-linear-gradient(135deg, var(--text-2) 0 2px, transparent 2px 5px); box-shadow: inset 0 0 0 1px var(--text-2); }
  .kind-3, .prec-3 { background: var(--muted); }
  .prec-4 { background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--border); }
  .mix { table-layout: fixed; width: 100%; min-width: 600px; }
  .mix th, .mix td { padding: 8px 5px; }
  .mix thead th { white-space: normal; vertical-align: bottom; line-height: 1.3; font: 500 11.5px Inter, system-ui, sans-serif; text-transform: none; letter-spacing: 0; }
  .mix thead th:first-child { width: 7.5rem; }
  .mix thead th:nth-child(2) { width: 4.5rem; }
  .mix thead th .dot { margin-right: 5px; }
  .mix tbody th { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mix-cell { font-variant-numeric: tabular-nums; }
  .mix-cell[tabindex]:focus-visible { outline: 2px solid var(--text); outline-offset: -2px; }

  .hbars { list-style: none; margin: 0; padding: 0; }
  .hbars li { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "label num" "bar bar"; align-items: baseline; gap: 3px 12px; padding: 5px 0; font-size: 13.5px; }
  .hbars.compact li { font-size: 13px; }

---
import Base from "../layouts/Base.astro";
import { submissionsAPI as api } from "../lib/submissions-config.js";
import { reports, totals, countByType, countriesWithReports, monthName, years } from "../lib/reports.js";
import { sourcesByDomain, sourcesByTld, SOURCE_KINDS, GENERIC_CC } from "../lib/source-domains.js";
import BandChart from "../components/stats/BandChart.astro";
import { TYPES, STATUS } from "../lib/types.js";
import { countryOf, flagOf, countryName } from "../lib/countries.js";
import { fmt, compact, tileNumber, headlineFigures, periodColumns, typeRows, reportsByModel, topCountriesBy, prisonBands, seizureBands, typeMixByRegion, sourceCountBands, weekdayCounts, seasonality, tagCloud, addedPerDay } from "../lib/stats.js";
import { formatWeight, formatWeightNumber } from "../lib/figures.js";
const base = import.meta.env.BASE_URL;
const domains = sourcesByDomain(reports);
const countries = countriesWithReports();
const figures = headlineFigures(reports);
const verified = reports.filter((r) => r.status === "verified").length;
const first = years.at(-1), last = years[0];
const byType = Object.entries(countByType(reports)).filter(([, n]) => n).sort((a, b) => b[1] - a[1]);
const maxType = Math.max(1, ...byType.map(([, n]) => n));
const regions = Object.entries(Object.groupBy(reports, (r) => countryOf(r.country)?.region ?? "Other")).map(([k, v]) => [k, v.length]).sort((a, b) => b[1] - a[1]);
const maxRegion = Math.max(1, ...regions.map(([, n]) => n));
const top = countries.slice(0, 15);
const maxTop = Math.max(1, ...top.map((c) => c.count));
// columns: every year from the first report, and the last 24 months
const yearCols = periodColumns(reports, (r) => r.year, Array.from({ length: (last ?? 0) - (first ?? 0) + 1 }, (_, i) => first + i));
const now = new Date(), months = Array.from({ length: 24 }, (_, i) => new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 23 + i, 1)).toISOString().slice(0, 7));
const monthCols = periodColumns(reports, (r) => r.month, months);
const chart = (cols, label, href) => { const max = Math.max(1, ...cols.map((c) => c.total)); return { max, cols: cols.map((c) => ({ ...c, h: (c.total / max) * 100, label: label(c.key), href: href(c.key), tip: JSON.stringify({ t: label(c.key), s: `${fmt(c.total)} ${c.total === 1 ? "report" : "reports"}`, rows: typeRows(c.types) }) })) }; };
const yearChart = chart(yearCols, (y) => String(y), (y) => `${base}${y}/`);
// the recent years dwarf the older ones, whose columns are slivers: their average, said in words
const older = yearCols.filter((c) => c.key <= (last ?? 0) - 3);
const olderNote = older.length > 1 ? `${older[0].key}–${older.at(-1).key}: ${fmt(older.reduce((n, c) => n + c.total, 0) / older.length)} reports a year on average so far.` : "";
const monthChart = chart(monthCols, (m) => monthName(m), (m) => `${base}${m.replace("-", "/")}/`);
const models = reportsByModel(reports);
const maxModel = Math.max(1, models.unrecorded, ...models.rows.map((m) => m.count));
const recorded = reports.length - models.unrecorded;
const leaders = [
  { title: "Most people arrested", figure: "arrested" },
  { title: "Most plants destroyed", figure: "plants_destroyed" },
  { title: "Most cannabis seized", figure: "kg_seized" },
].map((l) => ({ ...l, rows: topCountriesBy(reports, l.figure) })).filter((l) => l.rows.length);
const yearRows = years.map((y) => { const list = reports.filter((r) => r.year === y); return { y, list, t: totals(list), types: countByType(list) }; });
const pct = (n, of) => `${((n / Math.max(1, of)) * 100).toFixed(1)}%`;
// how long the stated prison terms are, and how big the stated seizures
const prison = prisonBands(reports), seizures = seizureBands(reports);
const yearsText = (y) => y < 1 ? `${Math.round(y * 12)} months` : `${y.toLocaleString("en-GB", { maximumFractionDigits: 1 })} years`;
// what enforcement looks like in each region: the share of its reports of each primary type
const mixTypes = byType.map(([id]) => id);
const mix = typeMixByRegion(reports, (r) => countryOf(r.country)?.region ?? "Other");
const shade = (share) => `color-mix(in srgb, var(--cite) ${Math.round(Math.min(1, share / 0.45) * 72)}%, var(--surface))`;
// the calendar: what day of the week reports fall on, and which months each type peaks in
const weekdays = weekdayCounts(reports);
// only complete years: the current one is collected unevenly (most of it in its last weeks)
const thisYear = new Date().getUTCFullYear();
const pastYears = reports.filter((r) => r.year < thisYear);
const seasons = seasonality(pastYears).filter((row) => row.total >= 20);
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const MONTHS_LONG = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const seasonShade = (share) => `color-mix(in srgb, var(--cite) ${Math.round(Math.min(1, share / 0.2) * 72)}%, var(--surface))`;
// how the tracker grew: reports added per day over the last 60 days
const dayName = (d, style) => new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: style, timeZone: "UTC" });
const addedCols = addedPerDay(reports).slice(-60);
// at least 30 days wide, so a young tracker's few days do not stretch across the chart
for (let d = new Date(`${addedCols[0]?.key ?? new Date().toISOString().slice(0, 10)}T00:00:00Z`); addedCols.length < 30;) { d.setUTCDate(d.getUTCDate() - 1); addedCols.unshift({ key: d.toISOString().slice(0, 10), total: 0, types: {}, cumulative: 0 }); }
const addedMax = Math.max(1, ...addedCols.map((c) => c.total));
const addedChart = { max: addedMax, cols: addedCols.map((c) => ({ ...c, h: (c.total / addedMax) * 100, label: dayName(c.key, "long"), href: null, tip: JSON.stringify({ t: dayName(c.key, "long"), s: `${fmt(c.total)} added · ${fmt(c.cumulative)} in all`, rows: typeRows(c.types) }) })) };
// tags and sources
const cloud = tagCloud(reports);
const tagged = reports.filter((r) => r.tags?.length).length;
const allTags = new Set(reports.flatMap((r) => r.tags ?? [])).size;
const bySite = sourcesByTld(reports);
const tldPlace = (tld) => { const id = tld === "uk" ? "gb" : tld; const c = tld.length === 2 && !GENERIC_CC.has(tld) && countryOf(id); return c ? { flag: flagOf(id), name: countryName(id) } : null; };
// generic endings (.com) dwarf any country's, so each group gets its own scale
const tldGroups = [["Generic endings", bySite.tlds.filter((t) => !tldPlace(t.tld)).slice(0, 6)], ["Country endings", bySite.tlds.filter((t) => tldPlace(t.tld)).slice(0, 15)]]
  .map(([title, rows]) => ({ title, rows, max: Math.max(1, ...rows.map((t) => t.sources)) }));
const ccShare = bySite.tlds.filter((t) => tldPlace(t.tld)).reduce((n, t) => n + t.sources, 0);
const perReport = sourceCountBands(reports);
const withMedia = reports.filter((r) => r.media?.length || r.cover).length;
const precisions = [["exact", "Exact spot"], ["locality", "Town or village"], ["district", "District"], ["region", "Region or state"], ["country", "Country only"]].map(([k, label]) => [label, reports.filter((r) => r.precision === k).length]).filter(([, n]) => n);
const sections = [["overview", "Overview"], ["time", "Over time"], ["calendar", "Calendar"], ["what", "What happened"], ["sizes", "Sentences and seizures"], ["where", "Where"], ["leaders", "Biggest figures"], ["tags", "Tags"], ["models", "AI models"], ["ai-usage", "AI usage"], ["years", "By year"], ["sources", "Sources"]];
---
<Base title="Statistics" description="Totals, timelines and breakdowns of the cannabis enforcement reports.">
  <h1>Statistics</h1>
  <p class="lead">What the {fmt(reports.length)} reports in the tracker add up to. These are only the figures the sources state, not estimates of all enforcement.</p>
  <nav class="stats-nav" aria-label="On this page">{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>

  <section id="overview" class="overview" aria-label="Overview">
    {/* the numbers are sized by the width of their own box, so they fit however large they grow */}
    <div class="headline">
      <div class="headline-main"><span class="headline-num">{fmt(reports.length)}</span><span class="headline-label">reports</span></div>
      <dl class="headline-facts">
        <div><dt>countries and states</dt><dd>{fmt(countries.length)}</dd></div>
        {first && <div><dt>years covered</dt><dd>{first}–{last}</dd></div>}
        <div><dt>checked against the sources</dt><dd>{pct(verified, reports.length).replace(/\.\d%/, "%")}</dd></div>
        <div><dt>source domains</dt><dd>{fmt(domains.length)}</dd></div>
      </dl>
    </div>
    <div class="figure-cards">
      {figures.map((f) => { const full = f.unit ? formatWeightNumber(f.value, 6) : fmt(f.value), short = tileNumber(f); return (
        <div class="figure-card">
          <div class="fc-num" title={`${full}${f.unit ? ` ${f.unit}` : ""}`}>{short}{f.unit && <small> {f.unit}</small>}</div>
          <div class="fc-label">{f.label}</div>
          <div class="fc-note">{short !== full && <>{full}{f.unit ? ` ${f.unit}` : ""} · </>}from {fmt(f.reports)} {f.reports === 1 ? "report" : "reports"}</div>
        </div>
      ); })}
    </div>
  </section>

  <section id="time" aria-labelledby="time-title">
    <h2 id="time-title">Over time</h2>
    <div class="chart-pair">
      {[["Reports per year", "by the date of the event", yearChart, 5, olderNote], ["The last 24 months", "reports per month", monthChart, 6, ""]].map(([title, sub, c, every, note]) => (
        <figure class="col-chart" data-chart>
          <figcaption><b>{title}</b> <span>{sub} · highest {fmt(c.max)}</span></figcaption>
          <div class="cols" style={`--n:${c.cols.length}`}>
            {c.cols.map((col) => <a class="col" href={col.href} data-tip={col.tip} aria-label={`${col.label}: ${col.total} reports`}><i style={`height:${col.h}%${col.total ? ";min-height:2px" : ""}`}></i></a>)}
          </div>
          <div class="col-axis" style={`--n:${c.cols.length}`}>
            {c.cols.map((col, i) => <span>{((i % every === 0 && c.cols.length - 1 - i >= every / 2) || i === c.cols.length - 1) && (c === yearChart ? col.key : monthName(col.key, "short").replace(" 20", " ’"))}</span>)}
          </div>
          {note && <p class="chart-note">{note}</p>}
        </figure>
      ))}
    </div>
    {addedChart.cols.length > 1 && <figure class="col-chart added-chart" data-chart>
      <figcaption><b>Added to the tracker</b> <span>reports added per day, by the day they were added · highest {fmt(addedChart.max)}</span></figcaption>
      <div class="cols" style={`--n:${addedChart.cols.length}`}>
        {addedChart.cols.map((col) => <div class="col" tabindex="0" data-tip={col.tip} aria-label={`${col.label}: ${col.total} reports added`}><i style={`height:${col.h}%${col.total ? ";min-height:2px" : ""}`}></i></div>)}
      </div>
      <div class="col-axis" style={`--n:${addedChart.cols.length}`} aria-hidden="true">
        {addedChart.cols.map((col, i, all) => { const every = Math.max(1, Math.ceil(all.length / 8)); return <span>{((i % every === 0 && all.length - 1 - i >= every / 2) || i === all.length - 1) && dayName(col.key, "short")}</span>; })}
      </div>
      <p class="chart-note">{fmt(addedChart.cols.at(-1).cumulative)} reports in all. Most older events were added in bulk when the tracker started, so the dates say when a report was written, not when the event happened.</p>
    </figure>}
  </section>

  <section id="calendar" aria-labelledby="calendar-title">
    <h2 id="calendar-title">Calendar</h2>
    <p class="muted">When in the week and the year events fall, by the date each report gives.</p>
    <div class="chart-pair">
      <BandChart title="Day of the week" sub={`${fmt(reports.length)} reports`} bands={weekdays}
        note={`${weekdays.reduce((a, b) => (b.count > a.count ? b : a)).label} is the busiest day, ${weekdays.reduce((a, b) => (b.count < a.count ? b : a)).label} the quietest; police and courts announce less at weekends.`} />
      <BandChart title="Sources per report" sub={`${perReport.mean != null ? `${perReport.mean.toLocaleString("en-GB", { maximumFractionDigits: 1 })} on average` : ""}`} bands={perReport.bands}
        note="How many sources each report cites; more sources usually mean more checked detail." />
    </div>
    <h3 class="mix-title">The seasons of enforcement</h3>
    <p class="muted">Each row spreads one type's reports over the calendar months, from the {fmt(pastYears.length)} reports dated before {thisYear} (the current year is still being collected, mostly in its latest weeks). The darker the cell, the larger that month's share; types with fewer than 20 reports are left out.</p>
    <div class="table-wrap" data-chart>
      <table class="table mix season">
        <thead><tr><th scope="col">Type</th><th scope="col" class="num">Reports</th>{MONTHS.map((m) => <th scope="col" class="num">{m}</th>)}</tr></thead>
        <tbody>{seasons.map((row) => <tr>
          <th scope="row"><i class="dot" style={`--c:${TYPES[row.type].color}`}></i>{TYPES[row.type].plural}</th><td class="num">{fmt(row.total)}</td>
          {row.counts.map((n, m) => { const share = row.shares[m]; return (
            <td class="num mix-cell" style={n ? `background:${seasonShade(share)}` : undefined} tabindex={n ? 0 : undefined}
              data-tip={n ? JSON.stringify({ t: `${TYPES[row.type].plural} in ${MONTHS_LONG[m]}`, s: `${fmt(n)} of ${fmt(row.total)} reports`, rows: [] }) : undefined}>
              {!n ? "–" : `${Math.round(share * 100)}%`}
            </td>
          ); })}
        </tr>)}</tbody>
      </table>
    </div>
  </section>

  <section id="what" aria-labelledby="what-title">
    <h2 id="what-title">What happened</h2>
    <div class="side-grid">
      <div>
        <h3>By type</h3>
        <ol class="hbars">{byType.map(([id, n]) => <li><span class="hb-label"><i class="dot" style={`--c:${TYPES[id].color}`}></i>{TYPES[id].plural}</span><span class="hb-track"><i style={`width:${(n / maxType) * 100}%`}></i></span><span class="hb-num">{fmt(n)}</span></li>)}</ol>
      </div>
      <div>
        <h3>How far each report is checked</h3>
        <div class="share" role="img" aria-label={Object.keys(STATUS).map((s) => `${s}: ${reports.filter((r) => r.status === s).length}`).join(", ")}>
          {Object.keys(STATUS).map((s, i) => { const n = reports.filter((r) => r.status === s).length; return n > 0 && <i class={`share-${i}`} style={`width:${pct(n, reports.length)}`} title={`${STATUS[s]}: ${fmt(n)}`}></i>; })}
        </div>
        <ul class="share-key">{Object.keys(STATUS).map((s, i) => { const n = reports.filter((r) => r.status === s).length; return n > 0 && <li><i class={`share-${i}`}></i><b>{fmt(n)}</b> {s} <span class="muted">· {STATUS[s].toLowerCase()} ({pct(n, reports.length)})</span></li>; })}</ul>
      </div>
    </div>
  </section>

  <section id="sizes" aria-labelledby="sizes-title">
    <h2 id="sizes-title">Sentences and seizures</h2>
    <p class="muted">How long the stated prison terms are, and how large the stated seizures. Each report counts once.</p>
    <div class="chart-pair">
      <BandChart title="Prison sentences" sub={`${fmt(prison.bands.reduce((n, b) => n + b.count, 0))} reports with a stated term${prison.median != null ? ` · median ${yearsText(prison.median)}` : ""}`} bands={prison.bands} apart={["Life", "Death sentence"]}
        note={`The longest single term a report states. Life and death sentences are shown apart (striped)${prison.unread ? `; ${fmt(prison.unread)} combined or unclear terms are left out` : ""}.`} />
      <BandChart title="Size of seizures" sub={`${fmt(seizures.total)} reports with a stated weight${seizures.median != null ? ` · median ${formatWeight(seizures.median, 3)}` : ""}`} bands={seizures.bands} note="Each band is ten times the one before it." />
    </div>
  </section>

  <section id="where" aria-labelledby="where-title">
    <h2 id="where-title">Where</h2>
    <div class="side-grid">
      <div>
        <h3>Countries with the most reports</h3>
        <ol class="hbars">{top.map((c) => <li><a class="hb-label" href={`${base}country/${c.id}/`}>{flagOf(c.id)} {c.name}</a><span class="hb-track"><i style={`width:${(c.count / maxTop) * 100}%`}></i></span><span class="hb-num">{fmt(c.count)}</span></li>)}</ol>
        <p class="more-links"><a href={`${base}country/`}>All {fmt(countries.length)} countries →</a></p>
      </div>
      <div>
        <h3>By region</h3>
        <ol class="hbars">{regions.map(([k, n]) => <li><span class="hb-label">{k}</span><span class="hb-track"><i style={`width:${(n / maxRegion) * 100}%`}></i></span><span class="hb-num">{fmt(n)}</span></li>)}</ol>
      </div>
    </div>
    <h3 class="mix-title">What enforcement looks like in each region</h3>
    <p class="muted">Each row splits one region's reports by their main type; the darker the cell, the larger its share.</p>
    <div class="table-wrap" data-chart>
      <table class="table mix">
        <thead><tr><th scope="col">Region</th><th scope="col" class="num">Reports</th>{mixTypes.map((t) => <th scope="col" class="num" title={TYPES[t].plural}><i class="dot" style={`--c:${TYPES[t].color}`}></i>{TYPES[t].label}</th>)}</tr></thead>
        <tbody>{mix.map((row) => <tr>
          <th scope="row">{row.region}</th><td class="num">{fmt(row.total)}</td>
          {mixTypes.map((t) => { const share = row.shares[t] ?? 0, n = row.counts[t] ?? 0; return (
            <td class="num mix-cell" style={share ? `background:${shade(share)}` : undefined} tabindex={n ? 0 : undefined}
              data-tip={n ? JSON.stringify({ t: `${TYPES[t].plural} in ${row.region}`, s: `${fmt(n)} of ${fmt(row.total)} reports`, rows: [] }) : undefined}>
              {!n ? "–" : share < 0.01 ? "<1%" : `${Math.round(share * 100)}%`}
            </td>
          ); })}
        </tr>)}</tbody>
      </table>
    </div>
  </section>

  <section id="leaders" aria-labelledby="leaders-title">
    <h2 id="leaders-title">Biggest figures by country</h2>
    <p class="muted">Totals of what the reports state; one large operation can lead a list.</p>
    <div class="leader-grid">
      {leaders.map((l) => { const max = l.rows[0].value; return (
        <div>
          <h3>{l.title}</h3>
          <ol class="hbars compact">{l.rows.map((c) => <li><a class="hb-label" href={`${base}country/${c.id}/`}>{flagOf(c.id)} {countryName(c.id)}</a><span class="hb-track"><i style={`width:${(c.value / max) * 100}%`}></i></span><span class="hb-num" title={l.figure === "kg_seized" ? formatWeight(c.value) : c.value.toLocaleString("en-GB")}>{l.figure === "kg_seized" ? formatWeight(c.value, 6) : compact(c.value)}</span></li>)}</ol>
        </div>
      ); })}
    </div>
  </section>

  <section id="tags" aria-labelledby="tags-title">
    <h2 id="tags-title">Tags</h2>
    <p class="muted">The {cloud.length} most used of {fmt(allTags)} tags, on {fmt(tagged)} reports; the bigger the tag, the more reports carry it. Each opens the reports with that tag.</p>
    <ul class="tag-cloud" data-chart>
      {cloud.map((t) => <li><a href={`${base}reports/?tag=${encodeURIComponent(t.tag)}`} class={`tc-${t.step}`} data-tip={JSON.stringify({ t: `#${t.tag}`, s: `${fmt(t.count)} reports`, rows: [] })}>#{t.tag}</a></li>)}
    </ul>
  </section>

  <section id="models" aria-labelledby="models-title" data-chart>
    <h2 id="models-title">Reports by AI model</h2>
    <p>The model recorded in each report's <code>created_by_model</code>, grouped without provider and reasoning setting. {fmt(recorded)} of {fmt(reports.length)} reports ({pct(recorded, reports.length)}) record it; older reports were imported before it was recorded.</p>
    <ol class="hbars models">{models.rows.map((m) => <li tabindex="0" data-tip={JSON.stringify({ t: m.name, s: `${fmt(m.count)} ${m.count === 1 ? "report" : "reports"}`, rows: m.variants.map(([id, n]) => ["", id, n]) })}><span class="hb-label">{m.name}</span><span class="hb-track"><i style={`width:${(m.count / maxModel) * 100}%`}></i></span><span class="hb-num">{fmt(m.count)}</span></li>)}
      {models.unrecorded > 0 && <li class="unrecorded"><span class="hb-label">Not recorded</span><span class="hb-track"><i style={`width:${(models.unrecorded / maxModel) * 100}%`}></i></span><span class="hb-num">{fmt(models.unrecorded)}</span></li>}
    </ol>
  </section>

  <section id="ai-usage" data-ai-stats data-api={api} aria-labelledby="ai-stats-title">
    <h2 id="ai-stats-title">AI research usage</h2>
    <p>Recorded research runs, including retries and interrupted attempts. Usage updates while research is running.</p>
    <label for="ai-stats-period">Period</label>{" "}
    <select id="ai-stats-period" disabled={!api}>
      <option value="all">All time</option><option value="30d">Last 30 days</option><option value="today">Today (UTC)</option>
    </select>
    <p id="ai-stats-status" role="status">{api ? "Loading AI usage…" : "Connect the submissions service to see AI usage."}</p>
    <div id="ai-stats-content" hidden data-no-glossary>
      <div class="tiles" id="ai-stats-tiles"></div>
      <div class="table-wrap"><table class="table">
        <thead><tr><th scope="col">Model</th><th scope="col" class="num">Runs</th><th scope="col" class="num">Input tokens</th><th scope="col" class="num">Output tokens</th><th scope="col" class="num">API cost</th><th scope="col" class="num" data-plan-cost hidden>Plan share</th></tr></thead>
        <tbody id="ai-stats-models"></tbody>
      </table></div>
      <p class="muted" id="ai-stats-note"></p>
    </div>
    <noscript><p>Enable JavaScript to load recorded AI usage.</p></noscript>
  </section>
  <script>import "../scripts/ai-stats.js";</script>

  <section id="years" aria-labelledby="years-title">
    <h2 id="years-title">By year</h2>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Year</th><th class="num">Reports</th>{byType.map(([id]) => <th class="num">{TYPES[id].plural}</th>)}<th class="num">Arrested</th><th class="num">Hectares</th></tr></thead>
        <tbody>{yearRows.map((r) => <tr><td><a href={`${base}${r.y}/`}>{r.y}</a></td><td class="num">{fmt(r.list.length)}</td>{byType.map(([id]) => <td class="num">{r.types[id] || "–"}</td>)}<td class="num">{fmt(r.t.arrested)}</td><td class="num">{fmt(Math.round(r.t.hectares))}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="more-links"><a href={`${base}${years[0] ?? ""}/`}>Browse by month →</a></p>
  </section>

  <section id="sources" aria-labelledby="source-domains-title" class="source-domains">
    <h2 id="source-domains-title">Sources</h2>
    <div class="side-grid sources-grid">
      <div data-chart>
        <h3>By top-level domain</h3>
        <p class="muted small">{fmt(bySite.tlds.length)} endings; {Math.round((ccShare / Math.max(1, bySite.total)) * 100)}% of sources are on a country's own domain (.br, .in…).</p>
        {tldGroups.map((g) => <>
        <h4 class="tld-group">{g.title}</h4>
        <ol class="hbars compact">{g.rows.map((t) => { const place = tldPlace(t.tld); return <li tabindex="0" data-tip={JSON.stringify({ t: `.${t.tld}${place ? ` · ${place.name}` : ""}`, s: `${fmt(t.sources)} sources in ${fmt(t.reports)} reports`, rows: [] })}><span class="hb-label"><span class="tld-flag" aria-hidden="true">{place ? place.flag : "🌐"}</span><code>.{t.tld}</code>{place && <span class="muted"> {place.name}</span>}</span><span class="hb-track"><i style={`width:${(t.sources / g.max) * 100}%`}></i></span><span class="hb-num">{fmt(t.sources)}</span></li>; })}</ol>
        </>)}
      </div>
      <div>
        <h3>Kind of site</h3>
        <p class="muted small">By the address alone: government, police and court domains count as official.</p>
        <div class="share" role="img" aria-label={SOURCE_KINDS.map(([k, label]) => `${label}: ${bySite.kinds[k]}`).join(", ")}>
          {SOURCE_KINDS.map(([k, label], i) => bySite.kinds[k] > 0 && <i class={`kind-${i}`} style={`width:${pct(bySite.kinds[k], bySite.total)}`} title={`${label}: ${fmt(bySite.kinds[k])}`}></i>)}
        </div>
        <ul class="share-key">{SOURCE_KINDS.map(([k, label, help], i) => bySite.kinds[k] > 0 && <li><i class={`kind-${i}`}></i><b>{fmt(bySite.kinds[k])}</b> {label.toLowerCase()} <span class="muted">· {help.toLowerCase()} ({pct(bySite.kinds[k], bySite.total)})</span></li>)}</ul>
        <h3 class="sub-title">How each report is documented</h3>
        <ul class="share-key">
          <li><b>{fmt(withMedia)}</b> with a photo or video <span class="muted">({pct(withMedia, reports.length)})</span></li>
        </ul>
        <div class="share" role="img" aria-label={precisions.map(([l, n]) => `${l}: ${n}`).join(", ")}>
          {precisions.map(([label, n], i) => <i class={`prec-${i}`} style={`width:${pct(n, reports.length)}`} title={`${label}: ${fmt(n)}`}></i>)}
        </div>
        <ul class="share-key">{precisions.map(([label, n], i) => <li><i class={`prec-${i}`}></i><b>{fmt(n)}</b> placed at: {label.toLowerCase()} <span class="muted">({pct(n, reports.length)})</span></li>)}</ul>
      </div>
    </div>
    <h3 class="mix-title">Every domain</h3>
    <p>{fmt(domains.length)} domains, ranked by distinct source URLs. The report count shows how many tracker reports cite each domain. Addresses with and without <code>www.</code> are combined.</p>
    <div class="source-domain-table">
      <table class="table">
        <thead><tr><th scope="col">Domain</th><th scope="col" class="num">Sources</th><th scope="col" class="num">Reports</th></tr></thead>
        <tbody id="source-domain-rows">{domains.map(({ domain, sources, reports }) => <tr>
          <td><a class="source-domain-link" href={`https://${domain}/`} target="_blank" rel="noopener noreferrer"><img src={`https://icons.duckduckgo.com/ip3/${encodeURIComponent(domain)}.ico`} width="16" height="16" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> <span>{domain}</span></a></td>
          <td class="num">{fmt(sources)}</td><td class="num">{fmt(reports)}</td>
        </tr>)}</tbody>
      </table>
    </div>
    {domains.length > 15 && <div class="more-row"><button type="button" class="more" id="show-all-domains" aria-controls="source-domain-rows" aria-expanded="false" hidden>Show all {fmt(domains.length)} domains</button></div>}
  </section>
  <script>
    const button = document.querySelector<HTMLButtonElement>("#show-all-domains");
    if (button) {
      const extra = [...document.querySelectorAll<HTMLTableRowElement>("#source-domain-rows tr")].slice(15);
      for (const row of extra) row.hidden = true;
      button.hidden = false;
      button.addEventListener("click", () => {
        for (const row of extra) row.hidden = false;
        button.setAttribute("aria-expanded", "true");
        button.hidden = true;
      });
    }
  </script>
  <script>import "../scripts/chart-tooltip.js";</script>
</Base>

<style>

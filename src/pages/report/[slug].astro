---
import { getCollection, render } from "astro:content";
import Icon from "../../components/Icon.astro";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import "../../styles/report.css";
import WorldMap from "../../components/WorldMap.astro";
import CfiWidget from "../../components/CfiWidget.astro";
import ReportItem from "../../components/ReportItem.astro";
import { reports, related, formatDate, isoDate, reportHistory } from "../../lib/reports.js";
import { TYPES, STATUS, PRECISION_INFO } from "../../lib/types.js";
import { flagOf, countryName } from "../../lib/countries.js";
import { landraceAt } from "../../lib/landrace.js";
import { relative } from "node:path";
import AddedAt from "../../components/AddedAt.astro";
import Fact from "../../components/Fact.astro";
import PhotoInfo from "../../components/PhotoInfo.astro";
import VideoFacade from "../../components/VideoFacade.astro";
import { legalContext } from "../../lib/legal-context.js";
import { glanceFacts } from "../../lib/details.js";
import { submissionsAPI } from "../../lib/submissions-config.js";
import { shortSubmission } from "../../lib/report-submission.js";
import { mediaView } from "../../lib/media.js";
import { photoOf, coverPlaceholderOf } from "../../lib/media-manifest.js";

export async function getStaticPaths() {
  const entries = await getCollection("reports");
  const history = reportHistory;
  return entries.map((entry) => ({ params: { slug: entry.id }, props: {
    entry, source: entry.filePath ? history.get(relative(process.cwd(), entry.filePath).replaceAll("\\", "/")) ?? null : null,
  } }));
}
const { entry, source } = Astro.props;
const r = reports.find((x) => x.id === entry.id);
const { Content, remarkPluginFrontmatter } = await render(entry);
const order = remarkPluginFrontmatter.citeOrder ?? r.sources.map((_, i) => i + 1);
const cited = order.map((i) => r.sources[i - 1]);
// the sources a structured value rests on, as the numbers the reader sees in the source list
const cites = (field) => (r.data_sources?.[field] ?? []).map((n) => order.indexOf(n) + 1).filter((n) => n > 0).sort((a, b) => a - b);
const base = import.meta.env.BASE_URL;
const more = related(r);
// the top of the page shows the main numbers and three facts; the full case data sits before the sources
const glanceFigures = r.figureRows.filter((f) => f.key !== "value").slice(0, 4);
const glance = glanceFacts(r.details);
const caseData = r.figureRows.length + r.detailRows.length > glanceFigures.length + glance.length;
// the law at the time: the CFI score that year, the law changes before the event, reforms since
const law = legalContext(r.country, r.date);
const fmtChangeDate = (d) => d.length === 10 ? new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) : d;
// photos with a direct address are shown from the publisher's own server (never copied here, see
// docs/WRITING.md §7); videos and photos without one stay links
const shown = (r.media ?? []).map((m) => ({ ...m, view: mediaView(m), photo: m.kind === "photo" ? photoOf(m.media_url) : null })).filter((m) => m.view);
const linked = (r.media ?? []).filter((m) => !mediaView(m));
const SOURCES_SHOWN = 8; // the sources listed before "Show all"
const languageName = (code) => new Intl.DisplayNames(["en"], { type: "language" }).of(code);
// the Landrace.wiki growing areas and regions the place lies in, when it is known closely enough
// (a province or a country centre says nothing about where in it)
const close = ["exact", "locality", "district"].includes(r.precision);
const landrace = close ? landraceAt(r.coordinates) : { areas: [], regions: [] };
const landraceLinks = [...landrace.areas.map((a) => ({ ...a, what: "growing area" })), ...landrace.regions.map((g) => ({ ...g, what: "growing region" }))];
// the place on other maps, zoomed as far as it is known
const [lat, lon] = r.coordinates ?? [];
const osmZoom = { exact: 16, locality: 13, district: 10, region: 7, country: 5 }[r.precision] ?? 6;
const mapLinks = r.coordinates ? [
  ["OpenStreetMap", `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=${osmZoom}/${lat}/${lon}`],
  ["Google Maps", `https://www.google.com/maps/search/?api=1&query=${lat},${lon}`],
] : [];
// the place and its country, the country left out when the place already ends with it
const where = r.place?.endsWith(r.countryName) ? r.place : [r.place, r.countryName].filter(Boolean).join(" · ");
// structured data for search: the report as an article about a place, with its sources and the
// breadcrumb the page shows
const site = new URL(base, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const tracker = { "@type": "Organization", "@id": `${site}#organization`, name: "Cannabis Enforcement Tracker", url: site };
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${pageUrl}#article`,
  headline: r.title.length > 110 ? r.title.slice(0, 107).replace(/\s+\S*$/, "") + "…" : r.title,
  name: r.title,
  description: r.summary,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  identifier: `CET-${r.code}`,
  inLanguage: "en",
  articleSection: [r.typeLabel, ...(r.also ?? []).map((type) => TYPES[type].label)],
  ...(r.added_at ? { datePublished: r.added_at, dateModified: r.updated_at ?? r.added_at } : {}),
  ...(r.cover ? { image: new URL(r.cover.image.src, Astro.site).href } : {}),
  author: tracker,
  publisher: tracker,
  isPartOf: { "@type": "WebSite", "@id": `${site}#website`, name: "Cannabis Enforcement Tracker", url: site },
  contentLocation: {
    "@type": "Place",
    name: where,
    address: { "@type": "PostalAddress", addressCountry: r.parent ? countryName(r.parent) : r.countryName, ...(r.parent ? { addressRegion: r.countryName } : {}), ...(r.place ? { addressLocality: r.place } : {}) },
    ...(close && r.coordinates ? { geo: { "@type": "GeoCoordinates", latitude: lat, longitude: lon } } : {}),
  },
  citation: cited.filter((s) => s.url).map((s) => ({ "@type": "CreativeWork", name: s.title, url: s.url, publisher: { "@type": "Organization", name: s.publisher } })),
}, {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Reports", item: new URL(`${base}reports/`, Astro.site).href },
    { "@type": "ListItem", position: 2, name: r.countryName, item: new URL(`${base}country/${r.country}/`, Astro.site).href },
    { "@type": "ListItem", position: 3, name: r.title, item: pageUrl },
  ],
}];
---
<Base title={r.title} description={r.summary} ogType="article" wide
  image={r.cover?.image.src} imageAlt={r.cover?.alt} imageWidth={r.cover?.image.width} imageHeight={r.cover?.image.height}
  published={r.added_at ?? undefined} modified={r.updated_at ?? r.added_at ?? undefined} jsonLd={jsonLd}>
  <meta slot="head" name="cet-report" content={r.id} />
  <nav class="crumbs" aria-label="Breadcrumb"><a href={`${base}reports/`}>Reports</a> / <a href={`${base}country/${r.country}/`}>{r.countryName}</a></nav>
  {/* on a wide screen the map and the law sit in a column beside the text; narrower, under it */}
  <div class="report-layout">
  <article id="report-article" class="report-article h-entry" data-country={r.country} itemscope itemtype="https://schema.org/Article">
    <header class="report-head">
      <div class="meta">
        <span class="type" style={`--c:${r.color}`}>{r.typeLabel}</span>
        {r.also?.map((t) => <span class="type" style={`--c:${TYPES[t].color}`}>{TYPES[t].label}</span>)}
        <time datetime={isoDate(r.date)}>{formatDate(r.date)}</time>
        <span class:list={["status", r.status]} title={STATUS[r.status]}>{r.status}</span>
        <a class="code" href={`${base}r/${r.code}/`} title="The report's permanent short id and link">CET-{r.code}</a>
      </div>
      <h1 class="p-name" itemprop="headline">{r.title}</h1>
      <p class="lead p-summary" itemprop="description">{r.summary}</p>
      <p class="muted">{flagOf(r.country)} {where}</p>
      <AddedAt value={r.added_at} updated={r.updated_at} />
    </header>

    {r.cover && (
      <figure class="cover">
        <Image src={r.cover.image} alt={r.cover.alt} widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 860px" style={coverPlaceholderOf(r.cover.image.src) ? `background:center/cover no-repeat url(${coverPlaceholderOf(r.cover.image.src)})` : undefined} />
        <figcaption><a href={r.cover.url} class="ext" target="_blank" rel="noopener">{r.cover.credit}</a> · {r.cover.licence}</figcaption>
      </figure>
    )}

    {(glanceFigures.length > 0 || glance.length > 0) && (
      <section class="glance" aria-label="At a glance">
        {glanceFigures.length > 0 && <dl class="glance-figures">{glanceFigures.map((f) => <div class="fact"><dt>{f.label}</dt><dd><Fact row={f} refs={cites(`figures.${f.key}`)} /></dd></div>)}</dl>}
        {glance.length > 0 && <dl class="glance-facts">{glance.map((f) => <div class="fact"><dt>{f.label}</dt><dd><Fact row={f} refs={cites(`details.${f.key}`)} /></dd></div>)}</dl>}
        {caseData && <a class="glance-more" href="#case-data">All case data and sources ↓</a>}
      </section>
    )}

    <div class="prose article-body e-content" itemprop="articleBody"><Content /></div>

    {r.media?.length > 0 && (
      <>
        <h2 id="media">Photos and video</h2>
        {shown.length > 0 && (
          <div class="media-grid" data-count={Math.min(shown.length, 4)} data-media-grid>
            {shown.map((m) => (
              <figure class:list={["media-tile", m.view.type !== "photo" && "media-tile-video"]}>
                {m.view.type === "photo" && <button type="button" class="media-open" aria-label={`Enlarge: ${m.caption}`} style={m.photo.placeholder ? `background-image:url(${m.photo.placeholder})` : undefined}>
                  <img src={shown.length > 2 ? m.photo.src : m.photo.full} data-full={m.photo.full} data-original={m.photo.original} data-ours={m.photo.ours ?? undefined} data-host={m.photo.host ?? undefined} width={m.photo.width ?? undefined} height={m.photo.height ?? undefined} style={m.photo.width ? `--ar:${m.photo.width} / ${m.photo.height}` : undefined} alt={m.caption} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                </button>}
                {(m.view.type === "video" || m.view.type === "embed") && <VideoFacade m={m} />}
                <figcaption>{m.caption}{m.photo && <PhotoInfo photo={m.photo} shownSrc={shown.length > 2 || m.photo.oursIsFull ? m.photo.src : m.photo.full} archived={m.archived} />} <span class="media-source">Source: <a href={m.url} class="ext" target="_blank" rel="noopener noreferrer">{m.publisher}</a>{m.archived && <> · <a href={m.archived} target="_blank" rel="noopener">archived copy</a></>}</span></figcaption>
              </figure>
            ))}
          </div>
        )}
        {linked.length > 0 && <ul class="media">
          {linked.map((m) => (
            <li><a href={m.url} class="ext" target="_blank" rel="noopener noreferrer">{m.caption}</a> <span class="muted">{m.kind === "video" ? "Video" : "Photos"}: {m.publisher}{m.archived && <>, <a href={m.archived} target="_blank" rel="noopener">archived copy</a></>}</span></li>
          ))}
        </ul>}
      </>
    )}

    {caseData && (
      <>
        <h2 id="case-data">Case data</h2>
        <p class="muted case-data-note">Every number and detail the sources state, with the sources that state it.</p>
        <dl class="report-details">
          {r.figureRows.map((f) => <div class="fact"><dt>{f.label}</dt><dd><Fact row={f} refs={cites(`figures.${f.key}`)} /></dd></div>)}
          {r.detailRows.map((d) => <div class="fact"><dt>{d.label}</dt><dd><Fact row={d} refs={cites(`details.${d.key}`)} /></dd></div>)}
        </dl>
      </>
    )}

    <h2 id="sources">Sources</h2>
    {/* one line each: who published it, the site, when, the language and an archived copy; the title
        is in the tooltip, and in the card a cited passage shows (report-citations.js). Past the first
        few, the rest wait behind "Show all" (src/scripts/sources-more.js) */}
    <ol class="sources" data-sources>
      {cited.map((s, i) => {
        const domain = s.url ? new URL(s.url).hostname.replace(/^www\./, "") : null;
        const title = [s.authors?.join(", "), s.title, s.container && `In ${s.container}`, s.locator].filter(Boolean).join(". ");
        const lang = s.language ? languageName(s.language) : null;
        return (
          <li id={`ref-${i + 1}`} data-n={i + 1} class:list={["src", { "src-extra": i >= SOURCES_SHOWN }]}>
            {s.url
              ? <a class="src-link" href={s.url} target="_blank" rel="noopener noreferrer" title={title}><span class="src-pub">{s.publisher || domain}</span>{domain && s.publisher && <span class="src-domain">{domain}</span>}</a>
              : <span class="src-link" title={title}><span class="src-pub">{s.publisher || s.title}</span></span>}
            {(s.date || s.year) ? <time class="src-date" datetime={s.date ? isoDate(s.date) : String(s.year)}>{s.date ? s.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) : s.year}</time> : <span class="src-date is-empty"></span>}
            {lang ? <abbr class="src-lang" title={`In ${lang}`}>{s.language.toUpperCase()}</abbr> : <span class="src-lang is-empty"></span>}
            {s.archived ? <a class="src-arch" href={s.archived} target="_blank" rel="noopener" title="Archived copy"><Icon name="archive" /><span class="sr-only">Archived copy</span></a> : <span class="src-arch is-empty"></span>}
            <span class="src-title" dir="auto" lang={s.language ?? undefined}>{title}</span>
          </li>
        );
      })}
    </ol>
    {cited.length > SOURCES_SHOWN && <button type="button" class="sources-more" data-sources-more data-label={`Show all ${cited.length} sources`}>Show all {cited.length} sources</button>}
    {r.open_questions?.length > 0 && <section class="report-questions" aria-labelledby="open-questions">
      <h2 id="open-questions">Open questions the AI reported</h2>
      <ul>{r.open_questions.map(question => <li>{question}</li>)}</ul>
    </section>}
    <footer class="report-provenance" aria-label="Report provenance">
      <div>
        {r.created_by_model !== "unknown" ? <p class="report-model"><span>Created with</span> <code>{r.created_by_model}</code></p> : <p class="report-model">Creator model: not recorded</p>}
        {r.submission && <p class="report-model" data-report-submission={r.submission} data-api={submissionsAPI}><span>From submission <a href={`${base}submission/?id=${r.submission}`}><code>{shortSubmission(r.submission)}</code></a><span data-facts></span></span></p>}
      </div>
      {source && <a class="report-updated" href={source.url} target="_blank" rel="noopener noreferrer" title="View this report’s source file on the main branch on GitHub">View report source ↗</a>}
    </footer>
  </article>

  <aside class="report-side">
    <section>
      <h2>Where</h2>
      {r.coordinates ? (
        <p class="map-place">{flagOf(r.country)} {where}</p>
        <div class="pin-map">
          <WorldMap focus={r} label={`Map: ${r.place ?? r.countryName}`} />
          {r.precision && <span class:list={["loc-chip", r.precision]} title={PRECISION_INFO[r.precision].text}>{PRECISION_INFO[r.precision].label}</span>}
          <a class="map-big" href={`${base}?range=all&focus=${r.id}`} title="Show this report on the world map, among all the others">
            <Icon name="open-new-window" />
            Big map
          </a>
        </div>
      ) : <p class="muted">No location given.</p>}
      {r.precision && (
        <p class="loc-accuracy">
          <b>Location accuracy: {PRECISION_INFO[r.precision].label.toLowerCase()}.</b>{" "}
          {r.precision === "country" ? `The sources name no closer place; the dot marks the middle of ${r.countryName}.` : PRECISION_INFO[r.precision].text}
          {r.place && r.precision !== "country" && <> Place: {r.place}.</>}
          <span class="loc-coords">{r.coordinates[0].toFixed(r.precision === "exact" ? 4 : 2)}, {r.coordinates[1].toFixed(r.precision === "exact" ? 4 : 2)}</span>
        </p>
      )}
      {landraceLinks.length > 0 && (
        <p class="loc-landrace">
          <b>Landrace cannabis.</b> {close && r.precision !== "district" ? "It happened in" : "The place lies in"}{" "}
          {landraceLinks.map((l, i) => <>{i > 0 && (i === landraceLinks.length - 1 ? " and " : ", ")}the {l.what} <a href={l.url} class="ext" target="_blank" rel="noopener">{l.name}</a>{l.status && l.status !== "Active" && <span class="muted"> ({l.status.toLowerCase()})</span>}</>)}
          {" "}on Landrace.wiki, where cannabis has been grown for generations.
        </p>
      )}
      {mapLinks.length > 0 && (
        <p class="loc-links">Open in {mapLinks.map(([name, href], i) => <>{i > 0 && " · "}<a href={href} class="ext" target="_blank" rel="noopener noreferrer">{name}</a></>)}</p>
      )}
    </section>
    <section>
      <h2>The law there</h2>
      <CfiWidget id={r.country} compact />
      {(law.scoreThen != null || law.before.length > 0) && (
        <div class="law-then">
          <h3>At the time</h3>
          {law.scoreThen != null && <p>CFI score in {law.year}: <b>{Math.round(law.scoreThen)}/100</b> ({law.tierThen}){law.scoreNow != null && Math.round(law.scoreNow) !== Math.round(law.scoreThen) && <>, now {law.scoreNow}/100</>}.</p>}
          {law.recentReform && <p class="law-recent">The law had changed within the year before: <a href={law.recentReform.url} class="ext" target="_blank" rel="noopener">{law.recentReform.title}</a> ({fmtChangeDate(law.recentReform.date)}).</p>}
          {law.before.length > 0 && <><p class="muted">CFI history before the event</p><ul class="law-changes">{law.before.map((c) => <li><time>{fmtChangeDate(c.date)}</time> <a href={c.url} class="ext" target="_blank" rel="noopener">{c.title}</a></li>)}</ul></>}
          {law.after.length > 0 && <><p class="muted">Since then</p><ul class="law-changes">{law.after.map((c) => <li><time>{fmtChangeDate(c.date)}</time> <a href={c.url} class="ext" target="_blank" rel="noopener">{c.title}</a></li>)}</ul></>}
        </div>
      )}
      <p><a href={`${base}country/${r.country}/`}>All reports from {r.countryName} →</a></p>
    </section>
  </aside>
  </div>

  {more.length > 0 && (
    <section class="related-reports">
      <h2>Related reports</h2>
      <ul class="reports">{more.map((x) => <ReportItem r={x} search={false} />)}</ul>
    </section>
  )}
</Base>

<script>import "../../scripts/report-citations.js"; import "../../scripts/sources-more.js";</script>
{r.submission && <script>import "../../scripts/report-submission.js";</script>}
{shown.some((m) => m.view.type === "photo") && <script>import "../../scripts/media-viewer.js";</script>}
{shown.some((m) => m.view.type !== "photo") && <script>import "../../scripts/video-facade.js";</script>}

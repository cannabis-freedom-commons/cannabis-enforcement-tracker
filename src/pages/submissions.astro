---
// All submitted sources and what became of them: one compact row each, linking to the request's own
// page (/submission/?id=). Rows, the AI worker line and the connection state are filled by
// src/scripts/submissions-table.js from the submissions API, live over a WebSocket.
import Base from "../layouts/Base.astro";
import { submissionsAPI as api } from "../lib/submissions-config.js";
import { FILTERS, ORIGINS } from "../lib/submission-status.js";
import "../styles/submissions-ui.css";
import "../styles/ai-activity.css";
import "../styles/submissions.css";
const base = import.meta.env.BASE_URL;
const npub = import.meta.env.PUBLIC_NOSTR_BOT_NPUB || "";
const relays = (import.meta.env.PUBLIC_NOSTR_RELAYS || "").split(",").filter(Boolean);
---
<Base title="Submissions" description="Every source sent to the tracker: what is being researched, what was published and why the rest was not." wide noindex>
  <div class="sx" data-submission-register data-submissions data-api={api} data-base={base}>
    <div class="sx-title">
      <h1>Submissions</h1>
      <button type="button" class="sx-btn sx-btn-primary sx-open-submit" data-open-submit disabled={!api}>+ Submit a source</button>
    </div>
    <p class="lead">Every news source sent to the tracker, and what became of it: researched by AI, checked against the sources, and published as a report or turned down with a reason. Anyone can send one and follow its way here.</p>
    <nav class="sx-nav" aria-label="On this page">{[["overview", "Overview"], ["publication", "Publication"], ["activity", "Activity"], ["outcomes", "What became of them"], ["working", "Working now"], ["all", "All submissions"]].map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>

    {/* the figures card, as on the statistics page: the register fills the headline
        (submissions-table.js), the outcomes the row below it (submissions-outcomes.js) */}
    <section id="overview" class="sx-overview" aria-label="Overview" aria-live="polite">
      <div class="sx-headline">
        <div class="sx-headline-main"><span class="sx-headline-num" id="register-total">—</span><span class="sx-headline-label">sources submitted</span></div>
        <dl class="sx-headline-facts">
          <div><dt>researching now</dt><dd id="register-running">—</dd></div>
          <div><dt>waiting · <span id="register-queue-estimate" title="Approximate time for queued and running cases at the last hour's commit rate, assuming no new arrivals. Budget pauses prevent an estimate.">Est. to clear: —</span></dt><dd id="register-queued">—</dd></div>
          <div><dt>reports committed per minute, last hour</dt><dd id="register-commit-rate">—</dd></div>
          <div><dt>AI research</dt><dd class="sx-headline-live"><span class="sx-live" id="register-connection" data-state="offline" role="status"><i aria-hidden="true"></i><span>{api ? "Connecting…" : "Offline"}</span></span></dd></div>
        </dl>
      </div>
      <div class="sx-worker-strip sx-worker" id="register-processing">{api ? "Checking the AI worker…" : "The submissions service is not connected."}</div>
      {api && <div class="sx-figures" id="register-outcome-figures" data-api={api}>
        <div class="sx-figure"><div class="sx-fig-num" data-fig="received">—</div><div class="sx-fig-label">Received · 24 h</div><div class="sx-fig-note" data-fig="received-note">&nbsp;</div></div>
        <div class="sx-figure"><div class="sx-fig-num" data-fig="committed">—</div><div class="sx-fig-label">Reports · 24 h</div><div class="sx-fig-note" data-fig="committed-note">&nbsp;</div></div>
        <div class="sx-figure"><div class="sx-fig-num" data-fig="published">—</div><div class="sx-fig-label">Published · 7 days</div><div class="sx-fig-note" data-fig="published-note">&nbsp;</div></div>
        <div class="sx-figure"><div class="sx-fig-num" data-fig="speed">—</div><div class="sx-fig-label">Source to report</div><div class="sx-fig-note" data-fig="speed-note">&nbsp;</div></div>
        <div class="sx-figure"><div class="sx-fig-num" data-fig="rate">—</div><div class="sx-fig-label">Became a report</div><div class="sx-fig-note" data-fig="rate-note">&nbsp;</div></div>
      </div>}
    </section>

    {/* the form opens over the page: the button by the title, or a link to #submit */}
    <dialog id="submit" class="sx-dialog" aria-labelledby="submit-source-title">
      <div class="sx-dialog-head">
        <h2 id="submit-source-title">Submit a source</h2>
        <button type="button" class="sx-dialog-close" data-close-submit aria-label="Close">✕</button>
      </div>
      <div class="sx-compose">
      <form id="submission-form">
        <label for="source-url">News URL</label>
        <div class="sx-compose-line">
          <input id="source-url" name="url" type="url" placeholder="https://example.com/news-story" required maxlength="4096" autocomplete="url" aria-describedby="submission-hint" disabled={!api} />
          <button type="submit" class="sx-btn sx-btn-primary" disabled={!api}>Submit source</button>
        </div>
        <details class="sx-compose-note"><summary>Add a public note <span>(optional)</span></summary>
          <label for="public-note">Public note</label>
          <textarea id="public-note" name="note" maxlength="500" rows="2" aria-describedby="note-hint" disabled={!api}></textarea>
          <p id="note-hint">Up to 500 characters. This note is public.</p>
        </details>
        <p id="submission-hint" class="sx-compose-hint">No account needed. Send a link to published reporting about a raid, seizure, eradication, arrest, prosecution or sentence. URLs, notes and outcomes are public and may remain on Nostr permanently.</p>
        <div id="submit-message" class="sx-message" role="status" aria-live="polite">{!api && "Submissions are not available yet. Please check back."}</div>
      </form>
      </div>
    </dialog>

    {/* committed reports on their way to the site: filled by src/scripts/submissions-publication.js */}
    {api && <section id="publication" class="sx-section sx-publication" data-api={api} aria-labelledby="publication-title" aria-live="polite" hidden>
      <h2 id="publication-title">Publication</h2>
      <div class="sx-card">
        <div class="sx-publication-steps" id="register-publication-steps">
          <div data-step="waiting"><strong data-pub="waiting">—</strong><span>Waiting for the next batch</span><small data-pub="next">—</small></div>
          <div data-step="deploying"><strong data-pub="deploying">—</strong><span>On main, deploying</span><small data-pub="build">—</small></div>
          <div data-step="last"><strong data-pub="last-reports">—</strong><span>In the last batch</span><small data-pub="last">—</small></div>
        </div>
        <p class="sx-publication-note" data-pub="note"></p>
      </div>
    </section>}

    {api && <section id="activity" class="sx-section sx-activity" data-submission-activity data-api={api} data-state="loading" aria-labelledby="activity-title">
      <div class="sx-section-head">
        <h2 id="activity-title">Activity</h2>
        <div class="sx-activity-switch" role="group" aria-label="Period">
          <button type="button" data-window="1h" aria-pressed="true">Last hour</button>
          <button type="button" data-window="24h" aria-pressed="false">Last 24 h</button>
        </div>
      </div>
      <div class="sx-card">
        <ul class="sx-activity-legend">
          <li data-key="committed"><i aria-hidden="true"></i>Committed <b data-total="committed">—</b></li>
          <li data-key="closed"><i aria-hidden="true"></i>Closed without a report <b data-total="closed">—</b></li>
          <li data-key="received"><i aria-hidden="true"></i>Received <b data-total="received">—</b></li>
          <li data-key="open"><i aria-hidden="true"></i>Waiting or running <b data-total="open">—</b></li>
          <li data-key="tokens" class="sx-activity-tokens">AI tokens <b data-total="tokens">—</b></li>
        </ul>
        <div class="sx-activity-frame">
          <div class="sx-activity-plot"></div>
          <div class="sx-activity-tip" role="status" hidden></div>
          <p class="sx-activity-note sx-activity-loading">Loading activity…</p>
          <p class="sx-activity-note sx-activity-error">Activity could not be loaded.</p>
        </div>
      </div>
    </section>}

    {api && <section id="outcomes" class="sx-section" aria-labelledby="outcomes-title" hidden data-outcomes>
      <h2 id="outcomes-title">What became of them</h2>
      <p class="sx-section-lead">Every source since the tracker began taking submissions. Several sources about one event make one report: the others add to it or are already covered.</p>
      <div class="sx-pair">
        <figure class="sx-card"><figcaption><b>Outcome</b> <span>by source</span></figcaption><ul class="sx-bars" data-bars="status"></ul></figure>
        <figure class="sx-card"><figcaption><b>Where they came from</b> <span>by submission</span></figcaption><ul class="sx-bars" data-bars="origin"></ul><p class="sx-card-note">Discovery reads Google News, Bing News and other feeds; people send links on the website and on Nostr.</p></figure>
      </div>
    </section>}

    <section id="working" class="sx-section sx-working" aria-labelledby="working-title">
      <h2 id="working-title">Working now <span id="register-working-count"></span></h2>
      <div class="sx-table sx-table-working" tabindex="0" role="region" aria-label="Currently running submissions; scroll horizontally on smaller screens">
        <div class="sx-grid-head" aria-hidden="true"><span>Received</span><span>ID</span><span>Source</span><span>Status</span><span>Model</span><span>Tokens in/out</span><span>Runs · time</span><span>Cost</span></div>
        <ol class="sx-list" id="register-working" aria-live="polite"><li class="sx-empty">Checking active work…</li></ol>
      </div>
      <p class="sx-table-note">Live processing across all sources. Restarted submissions appear here when work begins.</p>
    </section>
    <h2 id="all" class="sx-history-title">All submissions</h2>

    <div class="sx-toolbar">
      <div class="sx-filters" role="group" aria-label="Filter by status">
        {FILTERS.map(([value, label]) => <button type="button" class="sx-chip" data-filter={value} aria-pressed={value === "" ? "true" : "false"} disabled={!api}>{label}</button>)}
      </div>
      <div class="sx-toolbar-side">
        <select id="register-origin" aria-label="Filter by source" disabled={!api}>
          <option value="">All sources</option>
          {Object.entries(ORIGINS).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
        <span id="register-count" class="sx-count"></span>
      </div>
    </div>

    <div class="sx-table sx-table-updated" tabindex="0" role="region" aria-label="Submission table; scroll horizontally on smaller screens">
    <div class="sx-grid-head">
      <button type="button" class="sx-sort" data-sort="received" aria-sort="none" title="Sort by when the source arrived" disabled={!api}>Received</button>
      <button type="button" class="sx-sort" data-sort="updated" aria-sort="descending" title="Sort by the latest change" disabled={!api}>Updated</button>
      <button type="button" class="sx-sort" data-sort="id" aria-sort="none" title="Sort by receipt" disabled={!api}>ID</button>
      <button type="button" class="sx-sort" data-sort="source" aria-sort="none" title="Sort by source address" disabled={!api}>Source</button>
      <button type="button" class="sx-sort" data-sort="status" aria-sort="none" title="Sort by status" disabled={!api}>Status</button>
      <button type="button" class="sx-sort" data-sort="tokens" aria-sort="none" title="Sort by tokens read and written" disabled={!api}>Tokens in/out</button>
      <button type="button" class="sx-sort" data-sort="runs" aria-sort="none" title="Sort by time since the source arrived" disabled={!api}>Runs · time</button>
      <button type="button" class="sx-sort" data-sort="cost" aria-sort="none" title="Sort by API cost" disabled={!api}>Cost</button>
    </div>
    <ol class="sx-list" id="register-rows" aria-live="polite" aria-busy="true">
      <li class="sx-empty">{api ? "Loading submissions…" : "Submissions are not available yet."}</li>
    </ol>
    </div>
    <p class="sx-table-note">Token counts include all attempts. Open a row for details and restart controls.</p>
    <p id="register-message" class="sx-message" role="status"></p>

    <nav class="sx-pager" aria-label="Pages">
      <button id="register-newest" type="button" class="sx-btn" disabled>First</button>
      <button id="register-previous" type="button" class="sx-btn" disabled>← Previous</button>
      <span id="register-page">Page 1</span>
      <button id="register-next" type="button" class="sx-btn" disabled>Next →</button>
    </nav>
    <p class="sx-foot">Sources come from the website, Nostr and automatic discovery (RSS, GDELT). Addresses, public notes and outcomes are public; private research evidence is not shown.</p>
    <details class="submissions sx-saved-receipts"><summary>My saved receipts · import / export</summary>
    <section aria-labelledby="my-submissions-title">
      <h2 id="my-submissions-title">My submissions</h2>
      <p class="hint">Receipts are saved in this browser. Export them to keep a copy or move to another browser. Removing a receipt here does not delete its public submission or Nostr events.</p>
      <div class="actions">
        <button id="export-receipts" type="button">Export receipts</button>
        <label class="file-button" for="import-receipts" style="margin:0">Import receipts</label>
        <input id="import-receipts" class="visually-hidden" type="file" accept="application/json,.json" />
        <button id="refresh-submissions" type="button" disabled={!api}>Refresh</button>
      </div>
      <p id="receipts-message" class="notice" role="status" aria-live="polite"></p>
      <div id="receipts-list"></div>
      <div class="actions"><button id="receipts-prev" type="button" hidden>Previous</button><button id="receipts-next" type="button" hidden>Next</button></div>
    </section>
    </details>
    {npub && <details class="submissions sx-nostr-help"><summary>Submit from Nostr</summary>
    {npub && <section class="panel"><h2 style="margin-top:0">Submit from Nostr</h2><p>Mention <a href={`https://njump.me/${npub}`} class="ext">the tracker bot</a> with one news URL in a normal post. Include the bot as a tagged mention so it can receive your submission.</p><p class="hint" style="overflow-wrap:anywhere">{npub}</p><p>The bot replies in your thread when there is an outcome.</p>{relays.length > 0 && <><p class="hint">Publish to one of the bot’s read relays to help your mention reach it:</p><ul>{relays.map(relay => <li class="mono">{relay}</li>)}</ul></>}</section>}
    </details>}
    <noscript><p>JavaScript is needed to send sources and load submissions.</p></noscript>
    <script>
      // the submit dialog: from its buttons, from #submit links, closed by its ✕, Escape or a click outside
      const dialog = document.getElementById("submit") as HTMLDialogElement | null;
      if (dialog) {
        const open = () => { if (!dialog.open) { dialog.showModal(); dialog.querySelector<HTMLInputElement>("#source-url")?.focus(); } };
        document.querySelectorAll("[data-open-submit]").forEach((b) => b.addEventListener("click", open));
        dialog.querySelector("[data-close-submit]")?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
        dialog.addEventListener("close", () => { if (location.hash === "#submit") history.replaceState(null, "", location.pathname + location.search); });
        const fromHash = () => { if (location.hash === "#submit") open(); };
        window.addEventListener("hashchange", fromHash);
        fromHash();
      }
    </script>
  </div>
  <script>import "../scripts/submissions-table.js"; import "../scripts/submissions.js"; import "../scripts/submissions-activity.js"; import "../scripts/submissions-publication.js"; import "../scripts/submissions-outcomes.js";</script>
</Base>

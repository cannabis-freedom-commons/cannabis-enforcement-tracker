---
// One report in a list: type, date, place, title, summary and its main figures.
import { iconSvg } from "../lib/icons.js";
import { formatDate, isoDate } from "../lib/reports.js";
import { Image } from "astro:assets";
import { flagOf } from "../lib/countries.js";
import { photoOf, coverPlaceholderOf } from "../lib/media-manifest.js";
const { r, search = true, zoom = false } = Astro.props;
// zoom: a button at the end of the first line that shows the report on the page's map (the map's side pane)
const base = import.meta.env.BASE_URL;
const ZOOM_ICON = iconSvg("position");
const haystack = [r.title, r.summary, r.place, r.countryName, r.typeLabel, ...(r.tags ?? [])].join(" ").toLowerCase();
---
<li class:list={["report-item", { "has-thumb": r.cover || r.photo }]} data-id={r.id} data-type={r.type} data-also={(r.also ?? []).join(" ")}
  data-added={r.added_at ?? undefined} data-country={r.country} data-parent={r.parent ?? undefined} data-year={r.year} data-text={search ? haystack : undefined}>
  <div class="meta">
    <span class="type" style={`--c:${r.color}`}>{r.typeLabel}</span>
    <time datetime={isoDate(r.date)}>{formatDate(r.date)}</time>
    <a href={`${base}country/${r.country}/`}>{flagOf(r.country)} {r.countryName}</a>
    {zoom && r.coordinates && <button type="button" class="zoom-to" data-zoom={r.id} aria-label="Show on the map" title="Show on the map"><Fragment set:html={ZOOM_ICON} /></button>}
  </div>
  <h3><a href={`${base}${r.url}`}>{r.title}</a></h3>
  {/* the photo floats right after the title; the summary wraps around it */}
  {r.cover
    ? <Image class="thumb" src={r.cover.image} alt="" width={264} height={184} fit="cover" loading="lazy" style={coverPlaceholderOf(r.cover.image.src) ? `background-image:url(${coverPlaceholderOf(r.cover.image.src)})` : undefined} />
    : r.photo && <img class="thumb" src={photoOf(r.photo).src} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" style={photoOf(r.photo).placeholder ? `background-image:url(${photoOf(r.photo).placeholder})` : undefined} onerror="this.parentElement.classList.remove('has-thumb');this.remove()" onload="if(this.naturalWidth===260&&this.naturalHeight===180&&this.src.includes('duckduckgo')){this.parentElement.classList.remove('has-thumb');this.remove()}" />}
  <p>{r.summary}</p>
  {r.figureRows.length > 0 && (
    <div class="figs-inline">
      {r.figureRows.filter((f) => f.key !== "value").slice(0, 4).map((f) => <span>{f.label} <b>{f.value}</b></span>)}
    </div>
  )}
</li>

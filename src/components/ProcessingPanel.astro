---
// Live state of the submissions service, on the changelog: whether it answers, how many requests
// it is working on and how many wait, and which research models it uses. It holds the same
// WebSocket as the submissions list (/v1/submissions/stream) and re-reads /v1/status on each
// change; without a socket it asks every 20 seconds.
import { submissionsAPI as api } from "../lib/submissions-config.js";
import Icon from "./Icon.astro";
const base = import.meta.env.BASE_URL;
---
{api && <section class="processing" id="processing" data-api={api} data-state="checking" aria-labelledby="processing-title" aria-live="polite">
  <div class="processing-head">
    <Icon name="settings" class="processing-cog" />
    <h2 id="processing-title">Processing</h2>
    <span class="processing-state">Checking…</span>
    <a class="processing-link" href={`${base}submissions/`}>All requests →</a>
  </div>
  <dl class="processing-figures">
    <div><dt>Researching now</dt><dd data-figure="running">–</dd></div>
    <div><dt>Waiting</dt><dd data-figure="queued">–</dd></div>
    <div class="processing-models"><dt>Research</dt><dd data-figure="models">–</dd></div>
  </dl>
  <p class="processing-reason" hidden></p>
</section>}

<script>
  const box = document.getElementById("processing");
  if (box) {
    const api = (box.dataset.api || "").replace(/\/$/, "");
    const $ = (name: string) => box.querySelector<HTMLElement>(`[data-figure="${name}"]`)!;
    const stateLabel = box.querySelector<HTMLElement>(".processing-state")!;
    const reason = box.querySelector<HTMLElement>(".processing-reason")!;
    const number = (n: number) => n.toLocaleString("en-GB");
    const show = (state: string, label: string, why = "", running?: number, queued?: number) => {
      box.dataset.state = state;
      stateLabel.textContent = label;
      reason.hidden = !why; reason.textContent = why;
      if (running !== undefined) $("running").textContent = number(running);
      if (queued !== undefined) $("queued").textContent = number(queued);
    };
    // which models research uses, and how many requests it can work on at once
    const models = async () => {
      try {
        const r = await fetch(`${api}/v1/config`, { credentials: "omit", cache: "no-store" });
        if (!r.ok) return;
        const p = (await r.json()).processing;
        if (!p) return;
        const list = (p.agents || []).map((a: { model: string }) => a.model).filter(Boolean);
        const text = list.length ? list.join(", ") : p.model || "";
        $("models").textContent = text ? `${text}${p.max_running ? ` · up to ${p.max_running} at once` : ""}` : "not configured";
      } catch { /* the figures stay as they are */ }
    };
    let socket: WebSocket | null = null, live = false, failures = 0, retry = 0, poll = 0, pending = 0, lastCounts = 0;
    const counts = async () => {
      try {
        const r = await fetch(`${api}/v1/status`, { credentials: "omit", cache: "no-store" });
        if (!r.ok) throw new Error(String(r.status));
        const v = await r.json();
        if (!v.processing) show("paused", "AI research paused", v.reason || "", v.running, v.queued);
        else if (v.running) show("working", "Working", v.reason || "", v.running, v.queued);
        else show("online", "Online, idle", v.reason || "", v.running, v.queued);
      } catch { if (!live) show("offline", "Offline", "The submissions service does not answer."); }
    };
    // changes come every second while requests run: re-read the counts at most every 5 seconds
    const soon = () => {
      if (pending) return;
      pending = window.setTimeout(() => { pending = 0; lastCounts = Date.now(); counts(); }, Math.max(300, 5000 - (Date.now() - lastCounts)));
    };
    const tick = () => { clearTimeout(poll); if (document.hidden) return; counts(); poll = window.setTimeout(tick, 20000); };
    const connect = () => {
      if (socket || document.hidden || !window.WebSocket) return;
      try {
        const url = new URL(`${api}/v1/submissions/stream`, location.href); url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
        const current = new WebSocket(url); socket = current;
        current.onmessage = (e) => {
          try { if (JSON.parse(e.data).type === "submissions_changed") { live = true; failures = 0; soon(); } } catch { /* unknown message */ }
        };
        current.onclose = () => {
          if (socket !== current) return;
          socket = null; live = false; counts();
          if (!document.hidden) { clearTimeout(retry); retry = window.setTimeout(connect, Math.min(30000, 1000 * 2 ** Math.min(failures++, 5))); }
        };
      } catch { socket = null; }
    };
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) { socket?.close(); socket = null; live = false; clearTimeout(poll); clearTimeout(retry); }
      else { connect(); tick(); models(); }
    });
    connect(); tick(); models();
  }
</script>

<style>
  .processing { margin: 22px 0 26px; padding: 14px 16px 12px; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface); }
  .processing-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .processing-head h2 { margin: 0; font-size: 15px; font-weight: 600; }
  :global(.processing-cog) { width: 18px; height: 18px; flex: none; color: var(--muted); }
  .processing[data-state="online"] :global(.processing-cog) { color: #a8a69e; }
  .processing[data-state="working"] :global(.processing-cog) { color: #3fb36b; animation: processing-turn 2.4s linear infinite; }
  .processing[data-state="paused"] :global(.processing-cog) { color: #d9a43c; }
  .processing[data-state="offline"] :global(.processing-cog) { color: #d6545a; }
  .processing[data-state="checking"] :global(.processing-cog) { opacity: .4; }
  @keyframes processing-turn { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .processing[data-state="working"] :global(.processing-cog) { animation: none; } }
  .processing-state { font: 500 12px var(--mono); color: var(--text-2); }
  .processing[data-state="working"] .processing-state { color: #3fb36b; }
  .processing[data-state="paused"] .processing-state { color: #d9a43c; }
  .processing[data-state="offline"] .processing-state { color: #d6545a; }
  .processing-link { margin-left: auto; font-size: 13px; }
  .processing-figures { display: grid; grid-template-columns: auto auto 1fr; gap: 6px 32px; margin: 12px 0 0; }
  .processing-figures div { min-width: 0; }
  .processing-figures dt { font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .processing-figures dd { margin: 2px 0 0; font: 500 20px var(--mono); font-variant-numeric: tabular-nums; color: var(--text); }
  .processing-models dd { font: 13px/1.5 var(--mono); color: var(--text-2); padding-top: 5px; overflow-wrap: anywhere; }
  .processing-reason { margin: 10px 0 0; font-size: 12.5px; color: var(--muted); }
  @media (max-width: 640px) {
    .processing-figures { grid-template-columns: 1fr 1fr; }
    .processing-models { grid-column: 1 / -1; }
  }
</style>

---
// The Routes view's controls over the home page's map, where the reports' are (FilterBar): at the
// top what the lines measure, what was carried and how it travelled; at the bottom, in place of the
// reports' timeline, the routes' own: a column per year stacked by what was carried, a range of
// years dragged across it (or one year clicked), a play button that replays the years one by one,
// and the key. src/scripts/routes-view.js runs them.
import { MODES, PRODUCTS } from "../lib/routes.js";
import { routeYears } from "../lib/routes-years.js";
import Icon from "./Icon.astro";
const MODE_ICONS = { air: "airplane", road: "truck", sea: "sea-waves", mail: "mail" };
const MODE_TIPS = { air: "by air: luggage, couriers, air cargo", road: "by road or across a land border", sea: "by sea: ports, boats, containers", mail: "by post or parcel courier" };
const { part } = Astro.props; // "fields" (in the bar's row), "active" (the chips row) or "timeline"
const { first, last, perYear } = routeYears();
// a square-root scale, so the early years with a handful of routes still show next to the latest
const top = Math.sqrt(Math.max(1, ...perYear.map((y) => y.total)));
const n = perYear.length;
const every = n > 30 ? 5 : n > 8 ? 2 : 1;
---
{part === "fields" && <div class="routes-fields" id="routes-bar" role="group" aria-label="Filter routes">
  {/* what the lines' width measures */}
  <div class="icon-switch" role="group" aria-label="Line width">
    <button type="button" data-metric="reports" aria-pressed="true" data-tip="Line width: the number of reports on each route"><Icon name="hashtag" /><span class="sr-only">Width by reports</span></button>
    <button type="button" data-metric="kg" aria-pressed="false" data-tip="Line width: the kilograms seized on each route"><Icon name="weight" /><span class="sr-only">Width by kilograms</span></button>
  </div>
  {/* how it travelled: one way at a time, or any (none pressed) */}
  <div class="icon-switch" role="group" aria-label="How it travelled">
    {MODES.map(([id, label]) => <button type="button" data-mode={id} aria-pressed="false" data-tip={`Only routes travelled ${MODE_TIPS[id]} (click again for any way)`}><Icon name={MODE_ICONS[id]} /><span class="sr-only">{label}</span></button>)}
  </div>
</div>}
{/* what the map is narrowed to, each choice with its own ×, like the reports' filters */}
{part === "active" && <div class="map-active routes-active" id="routes-active" role="status" hidden>
    <span class="map-active-count" data-count></span>
    <span class="map-active-chips" data-chips></span>
    <button class="routes-clear" type="button" data-clear-all hidden>Clear all</button>
  </div>}
{part === "timeline" && <div class="routes-timeline" id="routes-timeline" style={`--n:${n}`}>
  {/* the kinds of cannabis switch on and off, like the reports' types; the places are only a key */}
  <div class="map-legend rt-legend" role="group" aria-label="Show only these kinds of cannabis" data-no-glossary>
    {PRODUCTS.map(([id, label, color]) => <button type="button" class="type" data-product={id} aria-pressed="false"><i class="key-dot" style={`--c:${color}`}></i>{label}</button>)}
    <span class="rt-key"><i class="key-node send"></i>mostly sends</span>
    <span class="rt-key"><i class="key-node receive"></i>mostly receives</span>
  </div>
  {/* a year is picked by clicking its column, several by dragging across them */}
  <div class="rt-cols" aria-label="Reports with a route per year, by kind of cannabis">
    {perYear.map((y) => { const h = (Math.sqrt(y.total) / top) * 100; return (
      <button type="button" class="rt-col" data-year={y.year} aria-pressed="false" aria-label={`${y.year}: ${y.total} reports with a route`} title={`${y.year}: ${y.total} ${y.total === 1 ? "report" : "reports"}`}>
        <span class="rt-stack" style={`height:${y.total ? Math.max(4, h) : 0}%`}>
          {y.products.map((k, i) => k > 0 && <i style={`flex-grow:${k};background:${PRODUCTS[i][2]}`}></i>)}
        </span>
      </button>
    ); })}
  </div>
  <div class="rt-axis" aria-hidden="true">{perYear.map((y, i) => <span>{(i % every === 0 || i === n - 1) && (i === n - 1 || n - 1 - i >= every / 2) ? y.year : ""}</span>)}</div>
</div>}

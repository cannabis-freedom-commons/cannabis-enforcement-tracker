---
// The filters of a list of reports: search with #tags, country, the time switch with a Custom
// period, "+ Filter" for a report's figures (people arrested, plants destroyed…), and the type key,
// whose types switch on and off. Under it, a row says what the list is narrowed to, each filter with
// its own ×. Markup only: ReportBrowser's script finds these by id, filters the list (and the map),
// and keeps them in the address.
//   layout "map": floating over the home page's map, the type key at the bottom over the timeline,
//     across which a period can be dragged; the time switch has rolling periods (24 hours…)
//   layout "page": in the flow of the Reports page or a country page, above its year chart, with
//     only All time and Custom (a list by year, not a window on recent events)
//   country: a country page's own country, fixed (no country choice)
import { reports, reportsOf, years as allYears, isoDate } from "../lib/reports.js";
import Icon from "./Icon.astro";
import { TYPES, typeIcon } from "../lib/types.js";
import { FIGURE_FILTERS, DETAIL_FILTERS, STATUSES } from "../lib/figure-filters.js";
import CountryPicker from "./CountryPicker.astro";
import Select from "./Select.astro";
const { layout = "map", country = null } = Astro.props;
const page = layout === "page";
const list = country ? reportsOf(country) : reports;
const years = country ? [...new Set(list.map((r) => r.year))].sort((a, b) => b - a) : allYears;

const usedTypes = Object.entries(TYPES).filter(([t]) => list.some((r) => r.type === t || r.also?.includes(t)));
const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const first = list.map((r) => isoDate(r.date)).sort()[0] ?? "";
---
<form class:list={["map-bar", { "is-page": page }]} id="map-bar" role="search" aria-label="Filter reports" onsubmit="return false">
  <div class="map-bar-main">
  {/* the home page: the switch between its views first, and the routes' own controls (RoutesBar) */}
  <slot name="start" />
  <div class="map-bar-row">
    <div class="range-switch" role="group" aria-label="Report time period">
      {!page && <>
        <button type="button" data-range="24h" aria-pressed="false" aria-label="Last 24 hours: reports dated yesterday or today" title="Reports dated yesterday or today">24<span class="rs-long">&nbsp;hours</span><span class="rs-short">h</span></button>
        <button type="button" data-range="7d" aria-pressed="false" aria-label="Last 7 days">7<span class="rs-long">&nbsp;days</span><span class="rs-short">d</span></button>
        <button type="button" data-range="30d" aria-pressed="true" aria-label="Last 30 days">30<span class="rs-long">&nbsp;days</span><span class="rs-short">d</span></button>
        <button type="button" data-range="1y" aria-pressed="false" aria-label="Last 12 months" title="Last 12 months">1y</button>
      </>}
      <button type="button" data-range="all" aria-pressed={page ? "true" : "false"} aria-label="All time">{page ? "All time" : "All"}</button>
      <button type="button" class="custom-toggle" id="custom-toggle" aria-pressed="false" aria-expanded="false" aria-controls="custom-period" aria-haspopup="dialog" title="Custom period: dates, a year or a month">
        {/* on the map a calendar icon until a period is chosen, then the period's name */}
        {!page && <Icon name="calendar" class="custom-icon" />}
        <span id="custom-label" data-default="Custom">Custom</span>
        {page && <Icon name="nav-arrow-down" />}
      </button>
    </div>
    <button type="button" class="map-bar-toggle" id="map-bar-toggle" aria-expanded="false" aria-controls="map-bar-fields" aria-label="Filters: search and country">
      <Icon name="filter-list" />
      <span class="map-bar-toggle-label">Filters</span><span class="filter-count" id="filter-count" hidden></span>
    </button>
  </div>
  <div class="map-bar-fields" id="map-bar-fields">
    <div class="map-search-box">
      <Icon name="search" />
      <button type="button" class="tag-chip" id="tag-chip" hidden>#<span></span><b aria-hidden="true">×</b></button>
      <input type="search" id="q" placeholder="Search reports, places, #tags…" aria-label="Search reports; type # for tags"
        role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="tag-suggest" autocomplete="off" spellcheck="false" />
      <ul class="tag-suggest" id="tag-suggest" role="listbox" aria-label="Tags" hidden></ul>
    </div>
    {/* on the map the country is one of the "+ Filter" choices, to keep the bar short */}
    {country
      ? <input type="hidden" id="country" value={country} data-fixed />
      : page && <CountryPicker id="country" />}
    <button type="button" class="add-filter" id="add-filter" aria-expanded="false" aria-controls="fig-popover" aria-haspopup="dialog">
      <Icon name="plus" /> Filter
    </button>
  </div>
  <slot name="routes" />
  <div class="custom-period fig-popover" id="fig-popover" role="dialog" aria-label="Filter by a figure" hidden>
    <div class="fig-choose"><span>Filter by</span>
      <Select id="fig-key" label="Filter by" value={FIGURE_FILTERS[0].key} groups={[
        { label: "Figures the report states", options: FIGURE_FILTERS.filter((f) => !f.report).map((f) => ({ value: f.key, label: f.label })) },
        { label: "What the report records", options: [...(!page && !country ? [{ value: "country", label: "Country or state" }] : []), ...DETAIL_FILTERS.map((f) => ({ value: `detail:${f.key}`, label: f.label }))] },
        { label: "The report", options: [...FIGURE_FILTERS.filter((f) => f.report).map((f) => ({ value: f.key, label: f.label })), { value: "status", label: "Check status" }, { value: "photo", label: "Has a photo" }] },
      ]} />
    </div>
    <fieldset class="custom-range" id="fig-range">
      <legend>Range (either end may be left empty)</legend>
      <label>At least <input type="number" id="fig-min" min="0" step="any" inputmode="decimal" /></label>
      <label>At most <input type="number" id="fig-max" min="0" step="any" inputmode="decimal" /></label>
    </fieldset>
    {!page && !country && <div class="fig-choose" id="fig-country-row" hidden><span>Country or state</span><CountryPicker id="country" /></div>}
    <div class="fig-choose" id="fig-status-row" hidden><span>Status</span>
      <Select id="fig-status" label="Status" value="verified" options={STATUSES.map(([value, label]) => ({ value, label }))} />
    </div>
    {DETAIL_FILTERS.map((f) => (
      <div class="fig-choose" id={`fig-detail-${f.key}`} data-detail-row hidden><span>{f.label}</span>
        <Select id={`fig-detail-value-${f.key}`} label={f.label} value={f.options[0][0]} options={f.options.map(([value, label]) => ({ value, label }))} />
      </div>
    ))}
    <button type="button" id="fig-apply">Add filter</button>
    <p class="custom-tip" id="fig-note">Only reports that state the figure are kept.</p>
  </div>
  <div class="custom-period" id="custom-period" role="dialog" aria-label="Custom period" hidden>
    <fieldset class="custom-range">
      <legend>From – to</legend>
      <label>From <input type="date" id="range-from" min={first} /></label>
      <label>To <input type="date" id="range-to" min={first} /></label>
      <button type="button" id="range-apply">Apply</button>
    </fieldset>
    <fieldset class="calendar-filters" id="calendar-filters">
      <legend>Or a calendar year and month</legend>
      <Select id="year" label="Year" all="All years" options={years.map((y) => ({ value: String(y), label: String(y) }))} />
      <Select id="month" label="Month" all="All months" options={MONTHS.map((m, i) => ({ value: String(i + 1).padStart(2, "0"), label: m }))} />
    </fieldset>
    <p class="custom-tip">{page ? "Or drag across the chart below." : "Or drag across the timeline at the bottom of the map."}</p>
  </div>
  </div>
  {/* the type key: in the bar on a page, over the timeline on the map */}
  {page && <div class="map-legend" role="group" aria-label="Show only these types">
    {usedTypes.map(([id, v]) => <button type="button" class="type" data-type-toggle={id} aria-pressed="false" title={v.help}><Fragment set:html={typeIcon(id, 16)} />{v.label}</button>)}
  </div>}
  <div class="map-active" id="map-active" role="status" hidden>
    <span class="map-active-count" id="map-active-count"></span>
    <span class="map-active-chips" id="map-active-chips"></span>
    <button class="clear-filters" id="mark-read" type="button" hidden>Mark all as read</button>
    <button class="clear-filters" id="clear-filters" type="button" hidden>Clear all</button>
  </div>
  <slot name="routes-active" />
  <input type="hidden" id="type" value="" />
  <input type="hidden" id="tag" value="" />
</form>
{!page && <div class="map-timeline">
  <div class="map-legend" role="group" aria-label="Show only these types">
    {usedTypes.map(([id, v]) => <button type="button" class="type" data-type-toggle={id} aria-pressed="false" title={v.help}><Fragment set:html={typeIcon(id, 16)} />{v.label}</button>)}
  </div>
  {/* drawn by the script; its height is kept from the start so the map does not jump when it loads */}
  <div class="months" id="months" aria-label="Reports over time, stacked by primary category" aria-busy="true"></div>
</div>}

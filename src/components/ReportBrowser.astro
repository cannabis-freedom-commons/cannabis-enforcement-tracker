---
// The filterable list of reports: free text, #tag, types, country, a period, and figures (people
// arrested, plants destroyed…) in the filter bar (FilterBar.astro), a strip of reports per period,
// and "Show more". The newest reports are in the page itself (for readers without scripts and
// for search engines); filtering and paging work on the shared index of all reports
// (/api/index.json). Used by the map's side pane (compact) and by the Reports page. The filters also
// narrow the map's markers ("reports:filter") and pointing at a report rings its marker
// ("reports:hover") where a map is on the page. With country, it lists only that country's reports
// (a country page): the country is fixed, not a filter. With mapFilters (the map), the filter bar and
// the timeline float over the map (FilterBar there), and this is only the count and the list.
import ReportItem from "./ReportItem.astro";
import ReportYears from "./ReportYears.astro";
import FilterBar from "./FilterBar.astro";
import { reports, reportsOf, years } from "../lib/reports.js";
import { TYPES } from "../lib/types.js";

const { page: PAGE = 30, compact = false, country = null, mapFilters = false } = Astro.props;
const all = country ? reportsOf(country) : reports;
const fmt = (n) => n.toLocaleString("en-GB");
const base = import.meta.env.BASE_URL;
const types = Object.fromEntries(Object.entries(TYPES).map(([k, v]) => [k, { label: v.label, color: v.color }]));
---
<div class:list={["browser", { compact }]}>
  {!mapFilters && <>
    <FilterBar layout="page" country={country} />
    {/* drawn by the script; its height is kept from the start so the page does not jump when it loads */}
    <div class="months" id="months" aria-label="Reports over time, stacked by primary category" aria-busy="true"></div>
  </>}
  <p class="count" id="count" aria-live="polite">{fmt(all.length)} reports · newest first</p>
  {/* the map's side pane: one plain list; the Reports page: by year, with a sticky month index */}
  {compact
    ? <ul class="reports" id="list" data-base={base} data-types={JSON.stringify(types)} data-page={PAGE}>
        {all.slice(0, PAGE).map((r) => <ReportItem r={r} search={false} zoom />)}
      </ul>
    : <div class="ry-all" id="list" data-years data-base={base} data-types={JSON.stringify(types)} data-page={PAGE}>
        <ReportYears reports={all.slice(0, PAGE)} />
      </div>}
  <p class="empty" id="empty" hidden={all.length > 0}>No report matches these filters.</p>
  {!compact && <>
    <div id="report-scroll-sentinel" aria-hidden="true" hidden></div>
    <p class="count" id="scroll-status" role="status" aria-live="polite"></p>
  </>}
  <p class="more-row">
    <button type="button" class="more" id="more" hidden={all.length <= PAGE}>Show more</button>
    {!country && <a class="muted" href={`${base}${years[0] ?? ""}/`}>Browse by month →</a>}
  </p>
</div>

<script>
  // Filters: free text, tag, type, country, year, month, exact day and the "+ Filter" ones (figures,
  // check status, photo). They narrow the list and map and are kept in the address
  // (?type=raid&country=ng&year=2026&plants=1000-), so a filtered view can be shared.
  import { loadIndex, inCountry, type Row } from "../scripts/report-index";
  import { yearsHTML, appendYears } from "../scripts/report-years.js";
  import { reportTimeline, timelineSelection, axisTicks, brushRange } from "../scripts/report-timeline.js";
  import { readPeriod, changePeriod, rangePeriod, periodLabel, recentPeriodBounds } from "../scripts/report-period.js";
  import { timelineTooltip } from "../scripts/report-timeline-tooltip.js";
  import { reportDay, compareReports } from "../lib/report-time.js";
  import { imageProxy } from "../lib/media.js";
  import { thumbHashToDataURL } from "thumbhash";
  import { hasTag } from "../lib/report-tags.js";
  import { initTagSuggest } from "../scripts/report-tag-suggest.js";
  import { FIGURE_FILTERS, DETAIL_FILTERS, STATUSES, parseRange, formatRange, rangeLabel, inRange, hasDetail } from "../lib/figure-filters.js";
  import { isNew, markAllAsRead, onUnreadChange } from "../scripts/unread-state.js";

  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const maybe = (id: string) => document.getElementById(id); // a part only one of the layouts has
  const hasBar = maybe("map-bar") != null; // the filter bar (FilterBar): over the map, or above the Reports list
  const list = $<HTMLElement>("list");
  const byYear = list.dataset.years != null; // the Reports page: grouped by year and month
  const base = list.dataset.base!, PAGE = Number(list.dataset.page), types = JSON.parse(list.dataset.types!);
  // a country page lists one country's reports: the country is fixed, never a filter or in the address
  const fixedCountry = $("country").dataset.fixed != null ? $("country").value : "";
  const fields = ["q", "type", ...(fixedCountry ? [] : ["country"]), "year", "month", "tag"];
  const params = new URLSearchParams(location.search);
  const dateOf = (r: Row) => reportDay(r);
  let day = "";
  const hideTimelineTooltip = timelineTooltip($("months"), types);
  for (const f of fields) if (params.get(f)) $(f).value = params.get(f)!;
  $("tag").value = $("tag").value.trim().toLowerCase();
  // the "+ Filter" filters: a range for any figure, the check status, and whether there is a photo
  const figs: Record<string, [number | null, number | null]> = {};
  for (const f of FIGURE_FILTERS) { const range = parseRange(params.get(f.key)); if (range) figs[f.key] = range; }
  let status = STATUSES.some(([v]) => v === params.get("status")) ? params.get("status")! : "";
  let photo = params.get("photo") === "1";
  // the structured-detail filters: one value each (?agency=ng-ndlea)
  const details: Record<string, string> = {};
  for (const f of DETAIL_FILTERS) { const v = params.get(f.key); if (v && f.options.some(([id]) => id === v)) details[f.key] = v; }
  // only the reports added since the reader's last visit (the header's "new" count links here)
  let newOnly = params.get("new") === "1";
  const extraCount = () => Object.keys(figs).length + Object.keys(details).length + (status ? 1 : 0) + (photo ? 1 : 0) + (newOnly ? 1 : 0);
  let updateTags: ((rows: Row[]) => void) | undefined;
  // One Time control owns both rolling periods and calendar selections.
  // Relative windows include calendar dates already reached in any local timezone.
  const RANGES: Record<string, number> = { "24h": 1, "7d": 7, "30d": 30, "1y": 365, all: 0 };
  const DEFAULT_RANGE = list.closest(".compact") ? "30d" : "all";
  let period = readPeriod(params, DEFAULT_RANGE, { allowRelative: !byYear, allowRange: hasBar });
  let range = period.range;
  const setPeriod = (next: ReturnType<typeof readPeriod>) => {
    period = { from: "", to: "", ...next }; range = next.range; day = next.date;
    $("year").value = next.year; $("month").value = next.month;
    document.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.range === next.mode));
    });
    if (hasBar) {
      const custom = next.mode === "calendar";
      $("custom-toggle").setAttribute("aria-pressed", String(custom));
      $("custom-label").textContent = custom ? periodLabel(period) : "Custom";
      $("range-from").value = period.from; $("range-to").value = period.to;
    }
  };
  setPeriod(period);
  const since = () => (RANGES[range] ? recentPeriodBounds(RANGES[range]).start : "");

  // the map's legend shows which types are on; on a phone, the Filters button counts what is set;
  // under the bar, a row names every filter in force (each with a × that drops it) and the count
  const PRESETS: Record<string, string> = { "24h": "Last 24 hours", "7d": "Last 7 days", "30d": "Last 30 days", "1y": "Last 12 months", all: "All time" };
  function showMapFilters() {
    if (!hasBar) return;
    const on = $("type").value.split(",").filter(Boolean);
    document.querySelectorAll<HTMLButtonElement>("[data-type-toggle]").forEach((b) => b.setAttribute("aria-pressed", String(on.includes(b.dataset.typeToggle!))));
    $("map-bar").classList.toggle("types-on", on.length > 0);
    // a country page's own country is not a filter: no chip, nothing to count or clear
    const n = ["q", ...(fixedCountry ? [] : ["country"]), "tag"].filter((f) => $(f).value.trim()).length + (on.length ? 1 : 0) + extraCount();
    $("filter-count").hidden = !n;
    $("filter-count").textContent = String(n);
    const chips: [string, string, string?][] = []; // [what × clears, label, colour]
    const q = $("q").value.trim().split(/\s+/).filter((w) => w && !w.startsWith("#")).join(" ");
    if (q) chips.push(["q", `“${q}”`]);
    if ($("tag").value) chips.push(["tag", `#${$("tag").value}`]);
    if (!fixedCountry && $("country").value) chips.push(["country", countries[$("country").value] ?? $("country").value]);
    for (const t of on) if (types[t]) chips.push([`type:${t}`, types[t].label, types[t].color]);
    if (period.mode !== DEFAULT_RANGE) chips.push(["period", period.mode === "calendar" ? periodLabel(period) : PRESETS[period.mode] ?? period.mode]);
    for (const f of FIGURE_FILTERS) if (figs[f.key]) chips.push([`fig:${f.key}`, rangeLabel(f, figs[f.key])]);
    for (const f of DETAIL_FILTERS) if (details[f.key]) chips.push([`detail:${f.key}`, `${f.label}: ${f.options.find(([id]) => id === details[f.key])?.[1] ?? details[f.key]}`]);
    if (status) chips.push(["status", STATUSES.find(([v]) => v === status)![1]]);
    if (photo) chips.push(["photo", "With a photo"]);
    if (newOnly) chips.push(["new", "New since your last visit"]);
    maybe("mark-read")?.toggleAttribute("hidden", !newOnly || !shown.length);
    const row = $("map-active");
    row.hidden = chips.length === 0;
    $("map-active-chips").replaceChildren(...chips.map(([key, label, color]) => {
      const b = document.createElement("button");
      b.type = "button"; b.className = "active-chip"; b.dataset.clear = key;
      b.setAttribute("aria-label", `Remove the filter ${label}`);
      if (color) { const dot = document.createElement("i"); dot.style.background = color; b.append(dot); }
      const text = document.createElement("span"); text.textContent = label;
      const x = document.createElement("b"); x.setAttribute("aria-hidden", "true"); x.textContent = "×";
      b.append(text, x);
      return b;
    }));
    $("map-active-count").textContent = `${shown.length.toLocaleString("en-GB")} ${shown.length === 1 ? "report" : "reports"}`;
  }

  const esc = (s = "") => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const fmtDate = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
  const flag = (id: string) => { const cc = id.split("/")[0].toUpperCase(); return /^[A-Z]{2}$/.test(cc) ? String.fromCodePoint(...[...cc].map((ch) => 0x1f1a5 + ch.charCodeAt(0))) : ""; };

  let rows: Row[] = [], countries: Record<string, string> = {}, haystack = new Map<Row, string>();
  let shown: Row[] = [], limit = PAGE, renderedCount = 0;
  let scrollObserver: IntersectionObserver | null = null;

  // a photo the publisher no longer serves is removed, and its row drawn without it
  // a photo's ThumbHash as a blurred placeholder, drawn under it until it loads
  const placeholders = new Map<string, string>();
  const placeholder = (hash: string) => {
    if (!placeholders.has(hash)) { try { placeholders.set(hash, thumbHashToDataURL(Uint8Array.from(atob(hash), (c) => c.charCodeAt(0)))); } catch { placeholders.set(hash, ""); } }
    return placeholders.get(hash);
  };
  const thumb = (r: Row) => r.im ? `<img class="thumb" src="${esc(r.it ?? imageProxy(r.im))}"${r.ih ? ` style="background-image:url(${placeholder(r.ih)})"` : ""} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.parentElement.classList.remove('has-thumb');this.remove()" onload="if(this.naturalWidth===260&&this.naturalHeight===180&&this.src.includes(\'duckduckgo\')){this.parentElement.classList.remove(\'has-thumb\');this.remove()}">` : "";
  const item = (r: Row) => `<li class="report-item${r.im ? " has-thumb" : ""}" data-id="${r.i}"${r.at ? ` data-added="${esc(r.at)}"` : ""} data-country="${esc(r.c)}">
    <div class="meta"><span class="type" style="--c:${types[r.t].color}">${esc(types[r.t].label)}</span>
      <time datetime="${r.d}">${fmtDate(r.d)}</time>
      <a href="${base}country/${r.c}/">${flag(r.c)} ${esc(countries[r.c])}</a>${zoomable && r.ll ? `<button type="button" class="zoom-to" data-zoom="${r.i}" aria-label="Show on the map" title="Show on the map"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="8" r="1.6" fill="currentColor"/><path d="M8 0.5v3M8 12.5v3M0.5 8h3M12.5 8h3" stroke="currentColor" stroke-width="1.5"/></svg></button>` : ""}</div>

    <h3><a href="${base}report/${r.i}/">${esc(r.ti)}</a></h3>
    ${thumb(r)}<p>${esc(r.s)}</p>
    ${r.f.length ? `<div class="figs-inline">${r.f.map(([l, v]) => `<span>${esc(l)} <b>${esc(v)}</b></span>`).join("")}</div>` : ""}
  </li>`;

  function matches(r: Row, skipDay = false, skipTag = false) {
    const date = dateOf(r);
    // a word still being typed as "#tag" waits for the tag to be chosen
    const q = $("q").value.trim().toLowerCase().split(/\s+/).filter((w) => w && !w.startsWith("#"));
    const type = $("type").value.split(",").filter(Boolean), country = $("country").value, year = $("year").value, month = $("month").value;
    return (!type.length || type.some((t) => r.t === t || r.a.includes(t)))
      && (!country || inCountry(r, country))
      && (!year || date.startsWith(year)) && (!month || date.slice(5, 7) === month)
      && (!period.from || date >= period.from) && (!period.to || date <= period.to)
      && (!since() || (date >= since() && date <= recentPeriodBounds(RANGES[range]).end))
      && (skipDay || !day || date === day)
      && (skipTag || hasTag(r, $("tag").value))
      && FIGURE_FILTERS.every((f) => !figs[f.key] || inRange(r, f, figs[f.key]))
      && DETAIL_FILTERS.every((f) => !details[f.key] || hasDetail(r, f, details[f.key]))
      && (!status || (r.st ?? "verified") === status) && (!photo || !!r.im) && (!newOnly || isNew(r.i, r.at))
      && q.every((w) => haystack.get(r)!.includes(w));
  }

  function render(append = false) {
    if (append) {
      const batch = shown.slice(renderedCount, limit);
      if (byYear) appendYears(list, batch, shown, item, base);
      else list.insertAdjacentHTML("beforeend", batch.map(item).join(""));
    } else {
      list.innerHTML = byYear ? yearsHTML(shown.slice(0, limit), shown, item, base) : shown.slice(0, limit).map(item).join("");
    }
    renderedCount = Math.min(limit, shown.length);
    document.dispatchEvent(new CustomEvent("reports:drawn"));
    const finished = renderedCount >= shown.length;
    $("more").hidden = finished || !!scrollObserver;
    const sentinel = document.getElementById("report-scroll-sentinel");
    if (sentinel) {
      sentinel.hidden = !scrollObserver || finished;
      if (scrollObserver) {
        scrollObserver.unobserve(sentinel);
        if (!finished) requestAnimationFrame(() => scrollObserver?.observe(sentinel));
      }
    }
    const status = document.getElementById("scroll-status");
    if (status) status.textContent = !shown.length ? "" : finished
      ? `All ${shown.length.toLocaleString("en-GB")} ${shown.length === 1 ? "report" : "reports"} shown`
      : `${renderedCount.toLocaleString("en-GB")} of ${shown.length.toLocaleString("en-GB")} reports shown · scroll for more`;
    $("empty").hidden = shown.length > 0;
    const narrowed = fields.some((f) => $(f).value) || !!day || range !== "all" || period.mode === "calendar" || extraCount() > 0;
    // the map's own default period (the last 30 days) is not something to clear
    const active = fields.some((f) => $(f).value) || !!day || period.mode !== DEFAULT_RANGE || extraCount() > 0;
    $("clear-filters").hidden = hasBar ? $("map-active-chips").children.length < 2 : !active && period.mode !== "calendar";
    const n = shown.length.toLocaleString("en-GB"), all = rows.length.toLocaleString("en-GB");
    const when = ({ "24h": "dated yesterday or today", "7d": "in the last 7 days", "30d": "in the last 30 days", "1y": "in the last 12 months" } as Record<string, string>)[range];
    $("count").textContent = !narrowed ? `${all} reports · latest incidents first`
      : `${n} of ${all} reports by incident date${day ? ` · ${fmtDate(day)}` : when ? ` ${when}` : hasBar && period.mode === "calendar" ? ` · ${periodLabel(period)}` : ""}`;
  }

  // The chart shares the map's filters, including its selected time window.
  function months() {
    const today = new Date().toISOString().slice(0, 10);
    // all time over five years or more: a bar per year; a shorter history: a bar per month
    const matching = rows.filter((r) => matches(r, true)), dates = matching.map(dateOf).filter(Boolean).sort();
    // a From–To period: a bar per day up to six months, per year beyond six years, else per month
    const custom = !!(period.from || period.to);
    const first = custom ? period.from || dates[0] || today : "", last = custom ? period.to || today : "";
    const span = custom ? (Date.parse(last) - Date.parse(first)) / 864e5 : 0;
    const daily = custom ? span <= 186 : range === "24h" || range === "7d" || range === "30d" || !!$("month").value || !!day;
    const longHistory = dates.length > 0 && Number(dates.at(-1)!.slice(0, 4)) - Number(dates[0].slice(0, 4)) >= 5;
    const yearly = custom ? span > 6 * 366 : range === "all" && !$("year").value && !daily && longHistory;
    const dayCalendar = !custom && day && range !== "24h" && range !== "7d" && range !== "30d";
    // Extend only for actual local-date reports, without an empty tomorrow bar.
    const lastLocal = dates.filter(d => d <= recentPeriodBounds(0).end).at(-1) || today;
    const chartEnd = lastLocal > today ? lastLocal : today;
    const series = reportTimeline(matching, {
      dateOf,
      start: custom ? first : since(), end: custom ? last : chartEnd,
      year: $("year").value || (dayCalendar ? day.slice(0, 4) : ""),
      month: $("month").value || (dayCalendar ? day.slice(5, 7) : ""), daily, yearly,
    });
    const box = $("months");
    box.removeAttribute("aria-busy");
    lastSeries = series; lastScale = yearly ? "year" : daily ? "day" : "month";
    if (!series.length) { box.innerHTML = ""; return; }
    const max = Math.max(1, ...series.map(b => b.total));
    box.dataset.caption = `Incidents per ${yearly ? "year" : daily ? "day" : "month"}`;
    box.setAttribute("aria-label", `Incidents per ${yearly ? "year" : daily ? "day" : "month"}, stacked by primary category; choose a bar to filter by ${yearly ? "year" : daily ? "day" : "month"}`);
    box.innerHTML = series.map(({ key, total, categories }) => {
      const label = new Date(`${yearly ? `${key}-01-01` : daily ? key : `${key}-01`}T00:00:00Z`).toLocaleDateString("en-GB", {
        ...(daily ? { day: "numeric" as const } : {}), ...(!yearly ? { month: "short" as const } : {}), year: "numeric", timeZone: "UTC",
      });
      const breakdown = Object.entries(types).filter(([id]) => categories[id]).map(([id, value]: [string, any]) => `${value.label}: ${categories[id]}`).join(", ");
      const description = `${label}: ${total} report${total === 1 ? "" : "s"}${breakdown ? ` (${breakdown})` : ""}`;
      const selected = daily ? day === key : yearly ? $("year").value === key : `${$("year").value}-${$("month").value}` === key;
      return `<button type="button" data-m="${key}" data-period="${yearly ? "year" : daily ? "day" : "month"}" data-period-label="${esc(label)}" data-total="${total}" data-categories="${esc(JSON.stringify(categories))}" aria-pressed="${selected}" aria-label="${esc(description)}"><span class="month-stack" style="height:${total / max * 100}%">${Object.entries(types).filter(([id]) => categories[id]).map(([id, value]: [string, any]) => `<i data-category="${id}" style="height:${categories[id] / total * 100}%;background:${value.color}"></i>`).join("")}</span></button>`;
    }).join("") + (byYear ? `<span class="months-scale" aria-hidden="true">${max.toLocaleString("en-GB")}</span>` : "") + `<span class="months-axis" aria-hidden="true"></span>`;
    drawAxis();
  }

  // the x axis: as many period labels as fit the chart's width, at round steps (every year, 5 years;
  // every month, quarter; every day, week), redrawn when the width changes
  let lastSeries: { key: string }[] = [], lastScale = "month";
  function drawAxis() {
    const axis = $("months").querySelector<HTMLElement>(".months-axis");
    if (!axis || !lastSeries.length) return;
    const n = lastSeries.length;
    axis.innerHTML = axisTicks(lastSeries.map((b) => b.key), lastScale, $("months").clientWidth).map(({ index, label }) =>
      `<span style="left:${((index + 0.5) / n) * 100}%">${esc(label)}</span>`).join("");
  }
  if ("ResizeObserver" in window) {
    let width = 0;
    new ResizeObserver(([entry]) => {
      if (Math.abs(entry.contentRect.width - width) < 4) return;
      width = entry.contentRect.width;
      drawAxis();
    }).observe($("months"));
  }

  function apply(resetLimit = true) {
    hideTimelineTooltip();
    if (resetLimit) limit = PAGE;
    shown = rows.filter((r) => matches(r)).sort(compareReports);
    showMapFilters();
    updateTags?.(rows.filter(r => matches(r, false, true)));
    render();
    months();
    (window as any).__reportsShown = new Set(shown.map((r) => r.i)); // for a map that loads later
    document.dispatchEvent(new CustomEvent("reports:filter", { detail: (window as any).__reportsShown }));
    const p = new URLSearchParams();
    for (const f of fields) if ($(f).value) p.set(f, $(f).value);
    if (day) p.set("date", day);
    if (period.from) p.set("from", period.from);
    if (period.to) p.set("to", period.to);
    if (period.mode !== DEFAULT_RANGE) p.set("range", period.mode);
    for (const f of FIGURE_FILTERS) if (figs[f.key]) p.set(f.key, formatRange(figs[f.key]));
    for (const f of DETAIL_FILTERS) if (details[f.key]) p.set(f.key, details[f.key]);
    if (status) p.set("status", status);
    if (photo) p.set("photo", "1");
    if (newOnly) p.set("new", "1");
    // the home page's Routes view keeps its own choices in the address while it is open
    if (document.documentElement.dataset.homeView !== "routes") history.replaceState(null, "", (p.size ? `?${p}` : location.pathname) + location.hash); // the hash is the map's view
  }

  // the target icon beside a title (where a map is on the page) flies the map to the report
  const zoomable = list.querySelector(".zoom-to") != null || (list.closest(".compact") != null && document.querySelector("[data-map]") != null);
  list.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".zoom-to");
    if (b) document.dispatchEvent(new CustomEvent("reports:zoom", { detail: b.dataset.zoom }));
  });
  // a month in a year's index that is not drawn yet: draw down to it, then go there
  list.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>(".ry-months a");
    if (!a || document.getElementById(a.hash.slice(1))) return;
    const month = a.hash.slice(2), at = shown.findIndex((r) => r.d.startsWith(month));
    if (at < 0) return;
    e.preventDefault();
    limit = Math.max(limit, at + PAGE);
    render();
    document.getElementById(a.hash.slice(1))?.scrollIntoView({ behavior: "instant" });
    history.replaceState(null, "", location.pathname + location.search + a.hash);
  });
  // pointing at a report in the list rings its marker on the map
  const hover = (id: string | null) => document.dispatchEvent(new CustomEvent("reports:hover", { detail: id }));
  list.addEventListener("mouseover", (e) => hover((e.target as HTMLElement).closest<HTMLElement>(".report-item")?.dataset.id ?? null));
  list.addEventListener("mouseleave", () => hover(null));
  // and pointing at a marker on the map marks its report in the list, where it is drawn
  document.addEventListener("map:hover", ((e: CustomEvent<string | null>) => {
    list.querySelector(".report-item.map-hovered")?.classList.remove("map-hovered");
    if (e.detail) list.querySelector(`.report-item[data-id="${CSS.escape(e.detail)}"]`)?.classList.add("map-hovered");
  }) as EventListener);

  // Dragging across two or more of the map's timeline bars picks the days they cover (a plain click
  // still picks one bar). The pointer is captured only once the drag reaches a second bar, so a click
  // stays a click on its bar.
  let dragged = false;
  if (hasBar) {
    const box = $("months");
    let drag: { start: number; end: number; pointer: number } | null = null;
    const bars = () => [...box.querySelectorAll<HTMLButtonElement>("button[data-m]")];
    const barAt = (x: number) => {
      const r = box.getBoundingClientRect(), n = bars().length;
      return Math.max(0, Math.min(n - 1, Math.floor(((x - r.left) / r.width) * n)));
    };
    const paint = () => bars().forEach((b, i) => b.classList.toggle("in-drag", !!drag && drag.start !== drag.end
      && i >= Math.min(drag.start, drag.end) && i <= Math.max(drag.start, drag.end)));
    box.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 || !bars().length) return;
      dragged = false;
      drag = { start: barAt(e.clientX), end: barAt(e.clientX), pointer: e.pointerId };
    });
    box.addEventListener("pointermove", (e) => {
      if (!drag || e.pointerId !== drag.pointer) return;
      const at = barAt(e.clientX);
      if (at === drag.end) return;
      if (!box.hasPointerCapture(e.pointerId)) box.setPointerCapture(e.pointerId);
      drag.end = at;
      hideTimelineTooltip();
      paint();
    });
    const end = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.pointer) return;
      const { start, end: stop } = drag, list = bars();
      drag = null;
      paint();
      if (e.type !== "pointerup" || start === stop) return;
      const picked = brushRange(list[start].dataset.m!, list[stop].dataset.m!);
      if (!picked) return;
      dragged = true; // the click that follows the drag is not a pick of one bar
      setTimeout(() => { dragged = false; });
      setPeriod(rangePeriod(picked.from, picked.to));
      apply();
    };
    box.addEventListener("pointerup", end);
    box.addEventListener("pointercancel", end);
  }

  // The map's bar: the Custom period's popover, the legend's types, and on a phone the Filters button.
  function initMapFilters() {
    // the map's Layers panel sits just above the timeline box (global.css), whose height it follows
    const timeline = document.querySelector<HTMLElement>(".map-timeline"), home = timeline?.closest<HTMLElement>(".home-map");
    if (timeline && home && "ResizeObserver" in window) new ResizeObserver(([entry]) => {
      home.style.setProperty("--timeline-h", `${Math.round(entry.borderBoxSize?.[0]?.blockSize ?? timeline.offsetHeight)}px`);
    }).observe(timeline);
    // a popover under its button: opened and closed by the button, closed by Escape or a click outside
    const popover = (panel: HTMLElement, button: HTMLElement, onOpen: () => void) => {
      const open = (show: boolean) => {
        panel.hidden = !show;
        button.setAttribute("aria-expanded", String(show));
        if (show) onOpen();
      };
      button.addEventListener("click", () => open(panel.hidden));
      document.addEventListener("pointerdown", (e) => {
        // a dropdown opened from the panel puts its list at the end of the page: still inside
        const inDropdown = (e.target as Element).closest?.('[data-slot^="select-"], [data-slot^="combobox-"]');
        if (!panel.hidden && !panel.contains(e.target as Node) && !button.contains(e.target as Node) && !inDropdown) open(false);
      });
      document.addEventListener("keydown", (e) => {
        // Escape in an open dropdown closes only the dropdown
        if (e.key === "Escape" && !panel.hidden && !document.querySelector('[data-slot$="-content"]:not([hidden])[data-state="open"]')) { open(false); button.focus(); }
      });
      return open;
    };
    const toggle = $("custom-toggle");
    const open = popover($("custom-period"), toggle, () => {
      $("range-to").max = $("range-from").max = new Date().toISOString().slice(0, 10);
      $("range-from").focus({ preventScroll: true });
    });
    // "+ Filter": choose a figure and its range (or the check status, or "has a photo"), then add it
    const addButton = $("add-filter"), figKey = $("fig-key");
    const showFigure = () => {
      const f = FIGURE_FILTERS.find((x) => x.key === figKey.value), range = f && figs[f.key];
      $("fig-range").hidden = !f;
      $("fig-status-row").hidden = figKey.value !== "status";
      const detail = DETAIL_FILTERS.find((x) => figKey.value === `detail:${x.key}`);
      document.querySelectorAll<HTMLElement>("[data-detail-row]").forEach((row) => { row.hidden = row.id !== `fig-detail-${detail?.key}`; });
      if (detail && details[detail.key]) $(`fig-detail-value-${detail.key}`).value = details[detail.key];
      $("fig-min").value = range?.[0] != null ? String(range[0]) : "";
      $("fig-max").value = range?.[1] != null ? String(range[1]) : "";
      if (figKey.value === "status") $("fig-status").value = status || "verified";
      $("fig-note").textContent = f ? (f.report ? f.note : `Only reports that state the figure are kept.${f.note ? ` ${f.note}` : ""}`) : detail ? "Only reports that record it, with a source." : figKey.value === "photo" ? "Reports with a photo of the event." : "Verified: every fact checked against the sources.";
      $("fig-apply").textContent = (f ? figs[f.key] : detail ? details[detail.key] : figKey.value === "status" ? status : photo) ? "Change filter" : "Add filter";
    };
    const openFig = popover($("fig-popover"), addButton, () => { showFigure(); figKey.focus({ preventScroll: true }); });
    figKey.addEventListener("change", showFigure);
    const applyFigure = () => {
      const f = FIGURE_FILTERS.find((x) => x.key === figKey.value);
      if (f) {
        const range = [$("fig-min").value, $("fig-max").value].map((v) => (v.trim() === "" ? null : Number(v))) as [number | null, number | null];
        if (range.some((v) => v != null && !(v >= 0))) return;
        if (range[0] == null && range[1] == null) delete figs[f.key];
        else figs[f.key] = range[0] != null && range[1] != null && range[0] > range[1] ? [range[1], range[0]] : range;
      } else if (figKey.value.startsWith("detail:")) {
        const key = figKey.value.slice(7), value = $(`fig-detail-value-${key}`).value;
        if (value) details[key] = value;
      } else if (figKey.value === "status") status = $("fig-status").value;
      else photo = true;
      apply();
      openFig(false);
      addButton.focus({ preventScroll: true });
    };
    $("fig-apply").addEventListener("click", applyFigure);
    for (const id of ["fig-min", "fig-max"]) $(id).addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); applyFigure(); } });
    const applyRange = () => {
      setPeriod(rangePeriod($("range-from").value, $("range-to").value));
      apply();
      open(false);
      toggle.focus({ preventScroll: true });
    };
    $("range-apply").addEventListener("click", applyRange);
    for (const id of ["range-from", "range-to"]) $(id).addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); applyRange(); } });
    document.querySelectorAll<HTMLButtonElement>("[data-type-toggle]").forEach((b) => b.addEventListener("click", () => {
      const on = new Set($("type").value.split(",").filter(Boolean)), id = b.dataset.typeToggle!;
      if (on.has(id)) on.delete(id); else on.add(id);
      $("type").value = [...on].join(",");
      apply();
    }));
    $("map-active-chips").addEventListener("click", (e) => {
      const key = (e.target as HTMLElement).closest<HTMLElement>("[data-clear]")?.dataset.clear;
      if (!key) return;
      if (key === "period") setPeriod(changePeriod(DEFAULT_RANGE, {}));
      else if (key === "q") $("q").value = "";
      else if (key.startsWith("type:")) $("type").value = $("type").value.split(",").filter((t) => t && t !== key.slice(5)).join(",");
      else if (key.startsWith("fig:")) delete figs[key.slice(4)];
      else if (key.startsWith("detail:")) delete details[key.slice(7)];
      else if (key === "status") status = "";
      else if (key === "photo") photo = false;
      else if (key === "new") newOnly = false;
      else $(key).value = "";
      apply();
      ($("map-active-chips").querySelector<HTMLElement>("[data-clear]") ?? $("q")).focus({ preventScroll: true });
    });
    const bar = $("map-bar"), more = $("map-bar-toggle");
    more.addEventListener("click", () => {
      const show = !bar.classList.contains("fields-open");
      bar.classList.toggle("fields-open", show);
      more.setAttribute("aria-expanded", String(show));
      if (show) $("q").focus({ preventScroll: true });
    });
  }

  loadIndex(base).then((idx) => {
    rows = fixedCountry ? idx.reports.filter((r) => inCountry(r, fixedCountry)) : idx.reports; countries = idx.countries;
    const onTag = (tag: string) => { $("tag").value = tag; apply(); };
    updateTags = initTagSuggest($("q"), $("tag-suggest"), $("tag-chip"), { selected: () => $("tag").value, onSelect: onTag });
    haystack = new Map(rows.map((r) => [r, [r.ti, r.s, r.p, countries[r.c], types[r.t].label, r.k].join(" ").toLowerCase()]));
    for (const f of fields) $(f).addEventListener("input", () => {
      if (f === "year" || f === "month") {
        const calendar = { mode: "calendar", range: "all", year: $("year").value, month: $("month").value, date: "" };
        setPeriod(hasBar && !calendar.year && !calendar.month ? changePeriod("all", {}) : calendar);
      }
      apply();
    });
    const loadMore = () => {
      if (renderedCount >= shown.length) return;
      limit = Math.min(shown.length, limit + PAGE);
      render(true);
    };
    $("more").addEventListener("click", loadMore);
    if (byYear && "IntersectionObserver" in window) {
      scrollObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) loadMore();
      }, { rootMargin: "600px 0px" });
      window.addEventListener("pagehide", () => scrollObserver?.disconnect());
      window.addEventListener("pageshow", (event) => {
        if (event.persisted && renderedCount < shown.length) scrollObserver?.observe($("report-scroll-sentinel"));
      });
    }
    $("months").addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button");
      if (!b || dragged) return;
      const key = b.dataset.m!;
      const selection = timelineSelection(key, { year: $("year").value, month: $("month").value, date: day });
      if (!selection) return;
      const inRange = (period.from || period.to) && /^\d{4}-\d{2}-\d{2}$/.test(key);
      if (inRange) setPeriod({ ...period, date: selection.date }); // a day inside a From–To period keeps the period
      else {
        if (selection.date) { selection.year = selection.date.slice(0, 4); selection.month = selection.date.slice(5, 7); }
        setPeriod({ mode: "calendar", range: "all", ...selection });
      }
      apply();
      ($("months").querySelector<HTMLButtonElement>(`button[data-m="${key}"]`) || $("months").querySelector<HTMLButtonElement>("button"))?.focus({ preventScroll: true });
      hideTimelineTooltip();
    });
    document.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((button) => button.addEventListener("click", () => {
      setPeriod(changePeriod(button.dataset.range!, { year: $("year").value, month: $("month").value, date: day }, ""));
      apply();
      if (period.mode === "calendar") $("year").focus();
    }));
    const clearFilters = () => {
      for (const field of fields) $(field).value = "";
      for (const key of Object.keys(figs)) delete figs[key];
      for (const key of Object.keys(details)) delete details[key];
      status = ""; photo = false; newOnly = false;
      setPeriod(changePeriod(DEFAULT_RANGE, {}));
      apply();
      $("q").focus({ preventScroll: true });
    };
    $("clear-filters").addEventListener("click", clearFilters);
    // everything listed is now read: the "new" filter has nothing left to show
    maybe("mark-read")?.addEventListener("click", () => { markAllAsRead(); newOnly = false; apply(); });
    onUnreadChange(() => { if (newOnly) apply(); });
    if (hasBar) initMapFilters();
    apply(); // by year: the counts and months of all reports
  });
</script>

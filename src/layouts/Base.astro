---
import "../styles/global.css";
import { reports } from "../lib/reports.js";
import { build } from "../lib/build-info.js";
// SEO props: `image` (a path or URL; the site card otherwise) with `imageAlt`, `noindex` for working
// views and empty pages, `published`/`modified` (ISO times) for articles, `jsonLd` (one object or a list).
const { title, description = "An open record of cannabis eradication, seizures, raids, arrests, prosecutions and sentences around the world.", wide = false, app = false, ogType = "website",
  image, imageAlt, imageWidth, imageHeight, noindex = false, published, modified, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL;
const SITE_NAME = "Cannabis Enforcement Tracker";
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: cannabis eradication, seizures, arrests and sentences worldwide`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// the share card: the page's own picture, else the site card (public/og.png, 1200×630)
const ogImage = new URL(image ?? `${base}og.png`, Astro.site).href;
const ogImageAlt = image ? imageAlt : "Cannabis Enforcement Tracker: a sourced world record of cannabis enforcement";
const [ogWidth, ogHeight] = image ? [imageWidth, imageHeight] : [1200, 630];
// search snippets are plain text of reasonable length; the full description stays for share cards
const snippet = description.length > 300 ? description.slice(0, 297).replace(/\s+\S*$/, "") + "…" : description;
const structured = [jsonLd].flat().filter(Boolean);
const here = Astro.url.pathname.replace(base, "/");
const REPO = "https://github.com/cannabis-freedom-commons/cet";
const builtLabel = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "UTC" }).format(new Date(build.built_at));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={snippet} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogWidth && <meta property="og:image:width" content={String(ogWidth)} />}
    {ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={snippet} />
    <meta name="twitter:image" content={ogImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    {structured.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />)}
    <slot name="head" />
    <meta name="theme-color" content="#0c0c0b" />
    {/* this build, for the update check and the "new since your last visit" marks (scripts/site-updates.js) */}
    <meta name="cet-build" content={build.id} />
    <meta name="cet-reports" content={String(build.reports)} />
    {build.latest_added && <meta name="cet-latest" content={build.latest_added} />}
    <meta name="cet-base" content={base} />
    <script is:inline>
      // the theme before the page is drawn: the reader's choice, else the system's
      (() => {
        let t = null;
        try { t = localStorage.getItem("theme"); } catch {}
        t ||= matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = t;
        document.documentElement.classList.add("js"); // scripts run: styles that rely on them may apply
        if (t === "light") document.querySelector('meta[name="theme-color"]').setAttribute("content", "#f4f2eb");
      })();
    </script>
    <link rel="alternate" type="application/rss+xml" href={`${base}feed.xml`} title="New reports (RSS)" />
    <link rel="alternate" type="application/json" href={`${base}api/reports.json`} title="All reports (JSON)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://x.pp0.co/js/pa-pXxzt8f14aSw4WXjIzIvp.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class:list={{ "app-body": app }}>
    <header class="topbar">
      <a class="brand" href={base}><span class="brand-mark" aria-hidden="true">✕</span><span><span class="brand-first">Cannabis </span>Enforcement Tracker</span></a>
      <span class="brand-by">by</span>
      <a class="cfi-link" href="https://cannabisfreedom.fyi/" target="_blank" rel="noopener" title="The companion site: what each country's cannabis laws allow">
        <!-- the Cannabis Freedom Index's own mark, its favicon (public/favicon.svg there), in the text colour -->
        <svg class="cfi-link-icon" viewBox="0 0 32 32" aria-hidden="true"><g transform="translate(16 26.4) scale(2.12)"><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(-31) scale(0.9)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(31) scale(0.9)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(-63) scale(0.7)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(63) scale(0.7)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(-97) scale(0.43)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(97) scale(0.43)"/></g></svg>
        <span class="cfi-link-long">Cannabis Freedom Index</span><span class="cfi-link-short">CFI</span> ↗
      </a>
      <span class="svc-counters">
      <a class="svc-total" href={`${base}changelog/`} title={`${reports.length.toLocaleString("en-GB")} reports · this version built ${builtLabel} UTC — changelog`} aria-current={here.startsWith("/changelog") ? "page" : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M8 14l2.5 2.5L16 11"/></svg>
        <span>{reports.length.toLocaleString("en-GB")}<span class="sr-only"> reports</span></span>
        {/* when this version of the site was built: the browser turns it into "3 hours ago" */}
        <span class="build-age"><span aria-hidden="true">·</span> updated <time datetime={build.built_at} data-relative>{builtLabel} UTC</time></span>
      </a>
      <a class="new-reports" id="new-reports" href={`${base}reports/?new=1`} hidden><span class="new-dot" aria-hidden="true"></span><span class="new-count"></span> new</a>
      </span>
      {import.meta.env.DEV && <button type="button" class="refresh-reports" id="refresh-reports" data-url={`${base}__dev/refresh-reports`} title="Load current reports and Git history">Refresh reports</button>}
      <nav class="nav">
        <a href={base} aria-current={here === "/" ? "page" : undefined}>Map</a>
        <a href={`${base}reports/`} aria-current={here.startsWith("/report") || /^\/\d{4}\//.test(here) ? "page" : undefined}>Reports</a>
        <a href={`${base}country/`} aria-current={here.startsWith("/country") ? "page" : undefined}>Countries</a>
        <a href={`${base}stats/`} aria-current={here.startsWith("/stats") ? "page" : undefined}>Statistics</a>
        <a href={`${base}about/`} aria-current={here.startsWith("/about") ? "page" : undefined}>About</a>
      </nav>
      <a class="github-link" href="https://github.com/cannabis-freedom-commons/cet" target="_blank" rel="noopener" aria-label="View source on GitHub" title="View source on GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.558 21.924c.563.103.768-.244.768-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.79-1.508-3.79-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.078-.686.078-.686 1.13.08 1.725 1.16 1.725 1.16 1.004 1.72 2.633 1.223 3.274.935.102-.727.393-1.223.714-1.504-2.5-.284-5.128-1.25-5.128-5.565 0-1.23.44-2.233 1.16-3.02-.117-.284-.503-1.43.11-2.98 0 0 .945-.302 3.094 1.154A10.78 10.78 0 0 1 12 6.18c.956.005 1.918.13 2.818.379 2.147-1.456 3.09-1.154 3.09-1.154.615 1.55.229 2.696.113 2.98.722.787 1.158 1.79 1.158 3.02 0 4.326-2.632 5.278-5.14 5.557.404.35.765 1.043.765 2.1 0 1.515-.014 2.737-.014 3.11 0 .3.203.65.774.54A11.252 11.252 0 0 0 12 .75Z"/></svg>
      </a>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch between dark and light">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </header>
    <script>
      // "3 hours ago" for every <time data-relative>, kept current while the page is open
      const relative = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
      const ago = (date: Date) => {
        const seconds = (date.getTime() - Date.now()) / 1000;
        for (const [unit, size] of [["year", 31536000], ["month", 2592000], ["week", 604800], ["day", 86400], ["hour", 3600], ["minute", 60]] as const) {
          if (Math.abs(seconds) >= size) return relative.format(Math.round(seconds / size), unit);
        }
        return "just now";
      };
      const update = () => document.querySelectorAll<HTMLTimeElement>("time[data-relative]").forEach((t) => {
        const date = new Date(t.dateTime);
        if (!Number.isNaN(date.getTime())) t.textContent = ago(date);
      });
      update();
      setInterval(update, 60000);
    </script>
    <main class:list={[app ? "app" : "page", { wide }]}>
      <slot />
    </main>
    {!app && (
    <footer class="footer">
        <p>
          A companion to the <a href="https://cannabisfreedom.fyi/" class="ext" target="_blank" rel="noopener">Cannabis Freedom Index</a>.
          Every report cites its sources. Data: <a href={`${base}api/reports.json`}>JSON</a> · <a href={`${base}feed.xml`}>RSS</a> · <a href={`${base}changelog/`}>Changelog</a> · <a href={`${base}submissions/`}>Submit</a>.
        </p>
        {/* the build this page is from: its commit and when it was built */}
        <p class="footer-build">
          {build.commit && <><a href={`${REPO}/commit/${build.commit}`} target="_blank" rel="noopener" title={`Built from commit ${build.commit}`}><code>{build.commit.slice(0, 7)}</code></a> · </>}
          <time datetime={build.built_at} title={`Built ${build.built_at}`}>built {builtLabel} UTC</time>
        </p>
      </footer>
    )}
    <script>import "../scripts/glossary.js";</script>
    <script>import "../scripts/site-updates.js";</script>
    <script>
      const refresh = document.querySelector<HTMLButtonElement>("#refresh-reports");
      refresh?.addEventListener("click", async () => {
        refresh.disabled = true;
        refresh.textContent = "Refreshing…";
        try {
          const response = await fetch(refresh.dataset.url!, { method: "POST" });
          if (!response.ok) throw new Error("Refresh failed");
          window.location.reload();
        } catch {
          refresh.disabled = false;
          refresh.textContent = "Retry refresh";
          refresh.title = "Could not refresh reports. Check the dev server output and retry.";
        }
      });
    </script>
    <script>
      // the theme switch; the map listens for "theme:change" to swap its basemap
      const root = document.documentElement;
      const set = (t: string, save: boolean) => {
        root.dataset.theme = t;
        if (save) { try { localStorage.setItem("theme", t); } catch {} }
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", t === "light" ? "#f4f2eb" : "#0c0c0b");
        document.dispatchEvent(new CustomEvent("theme:change", { detail: t }));
      };
      document.getElementById("theme-toggle")!.addEventListener("click", () => set(root.dataset.theme === "light" ? "dark" : "light", true));
      // follow the system while the reader has not chosen
      matchMedia("(prefers-color-scheme: light)").addEventListener("change", (e) => {
        let saved = null;
        try { saved = localStorage.getItem("theme"); } catch {}
        if (!saved) set(e.matches ? "light" : "dark", false);
      });
    </script>
  </body>
</html>

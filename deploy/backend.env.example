# The backend's settings on the server (compose.yaml reads them as .env.backend).
#   cp deploy/backend.env.example .env.backend && chmod 600 .env.backend
# Paths, RESEARCH_MODE=remote and REPO_SYNC are set by compose.yaml. Every other setting of
# backend/config.example.env can go here too.

# The public site, for links and allowed browser origins.
PUBLIC_BASE_URL=https://tracker.cannabisfreedom.fyi
CORS_ORIGINS=https://tracker.cannabisfreedom.fyi

# Research workers allowed to connect: name:token pairs, comma-separated. Make a token with
#   openssl rand -hex 32
# and give the same token to the worker (WORKER_TOKEN).
WORKER_TOKENS=home:

# Who the report commits are by.
GIT_AUTHOR_NAME=Cannabis Enforcement Tracker
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=Cannabis Enforcement Tracker
GIT_COMMITTER_EMAIL=
AUTO_PUBLISH=true
AUTO_PUSH=true

# The research budget, kept by the backend for every worker (cents; 0 = no daily limit).
RESEARCH_RUN_CENTS=100
RESEARCH_DAILY_CENTS=0
# The subscription the runs are paid from, shown on request pages (0 = API prices only).
RESEARCH_PLAN_USD=10
RESEARCH_PLAN_ALLOWANCE_USD=180
# Raw OpenCode logs on request pages.
RAW_AI_LOGS=true

# Discovery. The backend does not know the workers' slots: discovery holds new articles back while
# this many research jobs wait.
HARVEST_QUEUE_TARGET=24
HARVEST_GOOGLE_NEWS_ENABLED=true
HARVEST_BING_NEWS_ENABLED=true
LOG_LEVEL=info

# Nostr (blank: off). Generate with: docker compose run --rm tracker -keygen /data/nostr.env
NOSTR_GATEWAY_SECRET=
NOSTR_BOT_SECRET=
NOSTR_RELAYS=
# Machine ingest (at least 32 characters; blank: off).
INGEST_TOKEN=
# Prometheus metrics at /metrics, for Grafana (docs/DEPLOY.md, "Metrics"). Bearer token, at least
# 32 characters (openssl rand -hex 32); blank uses INGEST_TOKEN, and with neither /metrics is off.
METRICS_TOKEN=

# A research worker's environment (cmd/tracker-worker; docs/WORKERS.md). Copy outside the
# repository, chmod 0600, load it, then run: go run ./cmd/tracker-worker (in backend/).
# The backend it works for, as the worker reaches it (its public address), and one of the
# backend's WORKER_TOKENS.
TRACKER_URL=https://api.tracker.example
WORKER_TOKEN=
# This worker's own clone of the reports repository (git clone, then npm install and
# npm run browser-install in it). The worker fast-forwards it before every job and never commits.
REPO_PATH=/path/to/cet
# Job workspaces, page captures and kept OpenCode sessions.
WORKSPACE_PATH=data/worker-jobs
# Opening pages in Chromium (screenshots, JavaScript-rendered sources).
SOURCE_BROWSER=true
LOG_LEVEL=info

# Research settings, as in config.example.env.
RESEARCH_RUNNER=local
OPENCODE_BIN=opencode
OPENCODE_AUTH_FILE=
OPENCODE_CONFIG=
# RESEARCH_AGENTS='[{"model":"opencode-go/muse-spark-1.3-contributor#xhigh","max_workers":3}]'
RESEARCH_AGENTS=
RESEARCH_MODEL=
RESEARCH_TIMEOUT_SECONDS=900
RESEARCH_MAX_STEPS=24
RESEARCH_WEBSEARCH=exa
RESEARCH_CONTEXT=ab
# The research budget (RESEARCH_RUN_CENTS, RESEARCH_DAILY_CENTS) is the backend's; a worker's own
# values are ignored.

# Copy outside the repository, chmod 0600, then load into the service environment.
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=/var/lib/tracker/tracker.sqlite
PUBLIC_BASE_URL=https://tracker.cannabisfreedom.fyi
CORS_ORIGINS=https://tracker.cannabisfreedom.fyi
# Set only to the actual reverse proxy CIDRs; leave blank for direct connections.
TRUSTED_PROXY_CIDRS=
REPO_PATH=/srv/tracker/repository
WORKSPACE_PATH=/var/lib/tracker/jobs
DEMO_WORKER=false
# Blank keys disable Nostr; both must be distinct 64-character hex secrets.
NOSTR_GATEWAY_SECRET=
NOSTR_BOT_SECRET=
NOSTR_RELAYS=
# At least 32 random characters. Blank disables machine ingest and metrics.
INGEST_TOKEN=
# Optional collectors; pipe-separated queries, comma-separated feed URLs.
HARVEST_RSS_URLS=
HARVEST_GDELT_QUERIES=
# Google News RSS search runs at startup and periodically; blank uses the multilingual/country defaults.
HARVEST_GOOGLE_NEWS_ENABLED=true
HARVEST_GOOGLE_NEWS_INTERVAL=2m
HARVEST_GOOGLE_NEWS_MAX_ARTICLES=15
HARVEST_GOOGLE_NEWS_QUERIES_PER_SCAN=8
# Optional replacement set: up to 400 pipe-separated queries with [country:language] editions.
# Defaults rotate 293 queries (one-day language searches, seven-day country searches), 8 per scan.
HARVEST_GOOGLE_NEWS_QUERIES=
# Bing public news RSS runs independently; no API key required.
HARVEST_BING_NEWS_ENABLED=true
HARVEST_BING_NEWS_INTERVAL=3m
HARVEST_BING_NEWS_MAX_ARTICLES=8
HARVEST_BING_NEWS_QUERIES_PER_SCAN=5
# Blank uses built-in queries; optional pipe-separated queries with [language-COUNTRY] markets.
HARVEST_BING_NEWS_QUERIES=
# Discovery holds new articles back while this many research jobs wait; -1 = 4 per worker, 0 = off.
HARVEST_QUEUE_TARGET=-1
# info includes scan summaries and queued URLs; debug also logs duplicate candidates.
LOG_LEVEL=info
# OpenCode harness: local (macOS filesystem sandbox) or docker.
RESEARCH_RUNNER=docker
OPENCODE_BIN=opencode
# Local runner uses saved OpenCode auth; optional nonstandard auth file:
OPENCODE_AUTH_FILE=
# Optional JSON/JSONC provider config; defaults to ~/.config/opencode/opencode.json(c)
# (or $XDG_CONFIG_HOME/opencode/), with ~/.opencode/opencode.json(c) as a legacy base.
OPENCODE_CONFIG=
AUTO_PUBLISH=true
# Push the report repository to GitHub after each report commit (the machine's own Git credentials).
AUTO_PUSH=true
# Per-model worker limits (JSON array). Jobs choose randomly among ready agents with capacity.
# Takes precedence over legacy RESEARCH_MODEL / WORKER_CONCURRENCY when nonempty.
# RESEARCH_AGENTS='[{"model":"opencode-go/muse-spark-1.3-contributor#xhigh","max_workers":3},{"model":"swancloud/muse-spark-1.3-contributor#xhigh","max_workers":3}]'
RESEARCH_AGENTS=
# Legacy single-model configuration: requests worked on at once (1-8).
WORKER_CONCURRENCY=2
# Docker-only provider key. Local mode loads saved OpenCode credentials.
# Image built from research-image/, pushed and referenced by @sha256:<digest>.
RESEARCH_IMAGE=
RESEARCH_NETWORK=
# Required to enable research: provider/model, optionally #variant. No built-in default.
# Example: RESEARCH_MODEL=opencode-go/deepseek-v4.1-flash
RESEARCH_MODEL=
RESEARCH_API_KEY=
RESEARCH_TIMEOUT_SECONDS=900
# Model steps a research run may take before it must give its answer (4–100).
RESEARCH_MAX_STEPS=24
# OpenCode 2 search service: exa, parallel, firecrawl, tavily, tinyfish or random.
# Local runs import saved /connect credentials for the chosen service (all search services for random).
# Anonymous Exa/Parallel searches have separate limits; random enables provider fallback on HTTP 429.
RESEARCH_WEBSEARCH=exa
# Starting context: files (the agent reads request.json, the source, the editorial docs and skills
# itself), inline (request, source, metadata and candidates in the first message; CFI.md and
# WRITING.md in the system prompt; no skills), or ab (half the cases each, chosen by case ID).
# Compare with: go run ./cmd/tracker -compare-context
RESEARCH_CONTEXT=ab
# A subscription the runs are paid from (e.g. OpenCode Go): its monthly price and the model usage it
# includes at API prices. The request page then shows each run's share of it beside the API price.
# Leave at 0 to show API prices only.
RESEARCH_PLAN_USD=10
RESEARCH_PLAN_ALLOWANCE_USD=180
RESEARCH_RUN_CENTS=100
# Set to 0 for unlimited daily research; reservations and actual usage are still recorded.
RESEARCH_DAILY_CENTS=1000
# Legacy GitHub integration (not used by direct report commits): contents/PR write, deployments read; repository-limited.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO=burningtree/cannabis-freedom-index-tracker

# Raw event diagnostics (includes emitted reasoning and tool output). Enabled by backend-dev.
RAW_AI_LOGS=false

# Enabled by backend-dev; restart controls require a loopback-bound backend.
DEV_CONTROLS=false

# Render source pages with a fresh Playwright Chromium session and archive screenshots/SEO metadata.
# Install in the repository: npm install && npm run browser-install
SOURCE_BROWSER=true

# Public Astro build settings only. Never put service or provider secrets here.
# Dev proxies to http://127.0.0.1:8080 automatically; production requires this URL.
# To develop against the server's backend instead (no CORS changes needed):
# SUBMISSIONS_DEV_API=https://tracker-api.cannabisfreedom.fyi
# ...and its OPERATOR_TOKEN, so Restart works on localhost against it (only the dev proxy sends it):
# SUBMISSIONS_DEV_TOKEN=
PUBLIC_SUBMISSIONS_API_URL=
PUBLIC_NOSTR_BOT_NPUB=
PUBLIC_NOSTR_RELAYS=
